<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- 测试内文件操作无需响应取消，抑制 xUnit1051 -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- xunit.v3 内置 Microsoft.Testing.Platform；.NET 10 SDK 的 dotnet test 原生支持，无需 VSTest 适配器 -->
    <PackageReference Include="xunit.v3" />
    <!-- coverlet：覆盖率采集，用法 dotnet test 加 collect 参数（XPlat Code Coverage） -->
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\YetAnotherGameLauncher.Core\YetAnotherGameLauncher.Core.csproj" />
    <ProjectReference Include="..\YetAnotherGameLauncher.TestSupport\YetAnotherGameLauncher.TestSupport.csproj" />
  </ItemGroup>

</Project>
