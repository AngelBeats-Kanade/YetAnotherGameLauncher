[
  // CJK 字体依赖（Bottles cjkfonts.yml 同源方案）：
  // Adobe 思源黑体全量 ttc 覆盖简/繁/日/韩，经注册表把 Windows 系统字体名整体映射到思源黑体。
  // 2.004R-1（2026-10-27）：YAGL 修订，补 KRSDK 的 H7GBK 字体别名组；bump 版本让已装 2.004R 的用户重装生效。
  // 该组只修字体回退/缺字形，不修 KRSDK 协议正文的 cp1252 解码乱码（Wine riched20 RTF codepage bug，见 PITFALLS）。
  {
    "id": "cjk-fonts",
    "version": "2.004R-1",
    "downloadUrl": "https://github.com/adobe-fonts/source-han-sans/releases/download/2.004R/SourceHanSans.ttc.zip",
    "fileName": "SourceHanSans.ttc.zip",
    "md5": "ce3fc169af61a4e7bc650e7e78186330",
    "sizeBytes": 95184312,
    "fonts": [
      {
        "file": "SourceHanSans.ttc",
        "families": [
          "Source Han Sans SC ExtraLight", "Source Han Sans SC Light", "Source Han Sans SC Normal",
          "Source Han Sans SC", "Source Han Sans SC Medium", "Source Han Sans SC Bold", "Source Han Sans SC Heavy",
          "Source Han Sans TC ExtraLight", "Source Han Sans TC Light", "Source Han Sans TC Normal",
          "Source Han Sans TC", "Source Han Sans TC Medium", "Source Han Sans TC Bold", "Source Han Sans TC Heavy",
          "Source Han Sans ExtraLight", "Source Han Sans Light", "Source Han Sans Normal",
          "Source Han Sans", "Source Han Sans Medium", "Source Han Sans Bold", "Source Han Sans Heavy",
          "Source Han Sans K ExtraLight", "Source Han Sans K Light", "Source Han Sans K Normal",
          "Source Han Sans K", "Source Han Sans K Medium", "Source Han Sans K Bold", "Source Han Sans K Heavy"
        ]
      }
    ],
    "replacementGroups": [
      {
        "target": "Source Han Sans SC",
        "replaces": [
          "Dengxian", "FangSong", "KaiTi", "Microsoft YaHei", "Microsoft YaHei UI",
          "NSimSun", "SimHei", "SimKai", "SimSun", "SimSun-ExtB"
        ]
      },
      {
        // KRSDK 的 Config.txt 声明 fontName=文鼎方新书H7GBK_H / fontPath=H7GBKHeavy.TTF；
        // Wine 在 GB2312_CHARSET 下匹配不到这些全名时回退西文字体（独立于正文乱码）。
        "target": "Source Han Sans SC",
        "replaces": [
          "文鼎方新书H7GBK_H", "文鼎方新书H7GBK", "AR FangXinShuH7GBK",
          "AR FangXinShuH7GBK Heavy", "H7GBKHeavy", "Source Han Sans CN Regular"
        ]
      },
      {
        "target": "Source Han Sans TC",
        "replaces": [
          "DFKai-SB", "Microsoft JhengHei", "Microsoft JhengHei UI",
          "MingLiU", "PMingLiU", "MingLiU-ExtB", "PMingLiU-ExtB"
        ]
      },
      {
        "target": "Source Han Sans",
        "replaces": [
          "Meiryo", "Meiryo UI", "MS Gothic", "MS PGothic", "MS Mincho", "MS PMincho", "MS UI Gothic",
          "UD Digi KyoKasho N-R", "UD Digi KyoKasho NK-R", "UD Digi KyoKasho NP-R",
          "Yu Gothic", "Yu Gothic UI", "Yu Mincho",
          "メイリオ", "ＭＳ ゴシック", "ＭＳ Ｐゴシック", "ＭＳ 明朝", "ＭＳ Ｐ明朝"
        ]
      },
      {
        "target": "Source Han Sans K",
        "replaces": [
          "Batang", "BatangChe", "Dotum", "DotumChe", "Gulim", "GulimChe", "Gungsuh", "GungsuhChe", "Malgun Gothic",
          "바탕", "바탕체", "돋움", "돋움체", "굴림", "굴림체", "맑은 고딕"
        ]
      }
    ]
  },
  // 原生 RichEdit 依赖（Wine riched20 RTF codepage bug 的 workaround）：
  // 通过 winetricks 安装 Win7 SP1 原生 msftedit.dll（Win32/Win64 两份，首次约 1.5 GB 下载），
  // 再写入持久化 DllOverrides；修复 KRSDK 登录窗正文按 cp1252 解码的乱码。
  // 上游 Wine 未修复（2026-10-26 master 仍 todo_wine），故本项可选、默认不装。
  {
    "id": "richedit-msftedit",
    "version": "6.1.7601.17514",
    "winetricksVerb": "msftedit",
    "dlls": [
      // x64 → drive_c/windows/system32，x86 → drive_c/windows/syswow64（仅 win64 prefix）。
      {
        "arch": "x64",
        "fileName": "msftedit.dll",
        "sizeBytes": 799744,
        "sha256": "e15ed4fefc3010c213694331ddfdc03767682325c898d773ab243e2dc8b08461"
      },
      {
        "arch": "x86",
        "fileName": "msftedit.dll",
        "sizeBytes": 592384,
        "sha256": "04ed66befdb822181ebd1d84cbf0b17aaadf8455ae742f44d7adcb26ab07bdad"
      }
    ],
    // 持久化 registry 覆盖（不能只靠 WINEDLLOVERRIDES 环境变量）；卸载时按备份恢复旧值。
    "dllOverrides": { "*msftedit": "native,builtin" },
    "fonts": null,
    "replacementGroups": null
  }
]
