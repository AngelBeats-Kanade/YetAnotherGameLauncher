<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="YetAnotherGameLauncher.App"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant 跟随系统亮/暗；ThemeService 会按用户选择覆盖 -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#2E7CF6"/>
                    <SolidColorBrush x:Key="AppSidebarBackground" Color="#E2EDEFF3"/>
                    <SolidColorBrush x:Key="AppSidebarHover" Color="#B4FFFFFF"/>
                    <SolidColorBrush x:Key="AppSidebarSelected" Color="#C8D8E4FB"/>
                    <SolidColorBrush x:Key="AppCardBackground" Color="#D6FFFFFF"/>
                    <SolidColorBrush x:Key="AppCardBorder" Color="#66D5D9E0"/>
                    <SolidColorBrush x:Key="AppTextSecondary" Color="#66666E"/>
                    <SolidColorBrush x:Key="AppErrorText" Color="#C42B1C"/>
                    <SolidColorBrush x:Key="AppStatusOk" Color="#2DA44E"/>
                    <!-- 详情页版本号贴片：自带对比底面，压在任何插画上都可读 -->
                    <SolidColorBrush x:Key="AppVersionChipBackground" Color="#C7FFFFFF"/>
                    <SolidColorBrush x:Key="AppVersionChipText" Color="#2A2F36"/>
                    <!-- 应用自有背景（设置/关于/侧栏底色）：浅色 = 淡雾蓝渐变 + 柔和光晕 -->
                    <LinearGradientBrush x:Key="AppBackdropBaseBrush" StartPoint="0%,0%" EndPoint="35%,100%">
                        <GradientStop Color="#EFF2F8" Offset="0"/>
                        <GradientStop Color="#E2E9F4" Offset="0.55"/>
                        <GradientStop Color="#EBEEF6" Offset="1"/>
                    </LinearGradientBrush>
                    <RadialGradientBrush x:Key="AppBackdropGlowBrush" Center="82%,18%" RadiusX="0.55" RadiusY="0.5">
                        <GradientStop Color="#5A2E7CF6" Offset="0"/>
                        <GradientStop Color="#002E7CF6" Offset="1"/>
                    </RadialGradientBrush>
                    <RadialGradientBrush x:Key="AppBackdropGlowWarmBrush" Center="12%,88%" RadiusX="0.5" RadiusY="0.45">
                        <GradientStop Color="#47F0A64A" Offset="0"/>
                        <GradientStop Color="#00F0A64A" Offset="1"/>
                    </RadialGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#4C8DFF"/>
                    <SolidColorBrush x:Key="AppSidebarBackground" Color="#D9191920"/>
                    <SolidColorBrush x:Key="AppSidebarHover" Color="#5C2E2E38"/>
                    <SolidColorBrush x:Key="AppSidebarSelected" Color="#99304978"/>
                    <SolidColorBrush x:Key="AppCardBackground" Color="#A6202029"/>
                    <SolidColorBrush x:Key="AppCardBorder" Color="#4D3A3A4A"/>
                    <SolidColorBrush x:Key="AppTextSecondary" Color="#A2A2AB"/>
                    <SolidColorBrush x:Key="AppErrorText" Color="#FF8A7A"/>
                    <SolidColorBrush x:Key="AppStatusOk" Color="#3FB950"/>
                    <SolidColorBrush x:Key="AppVersionChipBackground" Color="#99000000"/>
                    <SolidColorBrush x:Key="AppVersionChipText" Color="#EEF1F6"/>
                    <!-- 应用自有背景：深空蓝黑渐变 + 蓝橙光晕（呼应应用图标） -->
                    <LinearGradientBrush x:Key="AppBackdropBaseBrush" StartPoint="0%,0%" EndPoint="35%,100%">
                        <GradientStop Color="#0C0F1D" Offset="0"/>
                        <GradientStop Color="#131A2E" Offset="0.55"/>
                        <GradientStop Color="#0D1019" Offset="1"/>
                    </LinearGradientBrush>
                    <RadialGradientBrush x:Key="AppBackdropGlowBrush" Center="82%,18%" RadiusX="0.55" RadiusY="0.5">
                        <GradientStop Color="#404C8DFF" Offset="0"/>
                        <GradientStop Color="#004C8DFF" Offset="1"/>
                    </RadialGradientBrush>
                    <RadialGradientBrush x:Key="AppBackdropGlowWarmBrush" Center="12%,88%" RadiusX="0.5" RadiusY="0.45">
                        <GradientStop Color="#33E8930C" Offset="0"/>
                        <GradientStop Color="#00E8930C" Offset="1"/>
                    </RadialGradientBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <!-- 主题无关的资源 -->
            <SolidColorBrush x:Key="AppPredownloadBadge" Color="#E8930C"/>
            <!-- 详情页遮罩（暗遮罩+白字方案，两主题一致）：顶部轻、中段压状态区、底部压实内容 -->
            <Color x:Key="AppBackdropScrimTopColor">#14000000</Color>
            <Color x:Key="AppBackdropScrimMidColor">#66000000</Color>
            <Color x:Key="AppBackdropScrimBottomColor">#B3000000</Color>
            <!-- 详情页"插画上"前景：标题/状态用主色，次要信息用次色 -->
            <SolidColorBrush x:Key="AppOnArtworkBrush" Color="#F2F4F8"/>
            <SolidColorBrush x:Key="AppOnArtworkSecondary" Color="#C9CED8"/>
            <SolidColorBrush x:Key="AppOnArtworkCard" Color="#B3202029"/>
            <SolidColorBrush x:Key="AppOnArtworkCardHover" Color="#D9323040"/>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme/>
    </Application.Styles>
</Application>
