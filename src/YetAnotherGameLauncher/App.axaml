<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="YetAnotherGameLauncher.App"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant 跟随系统亮/暗；ThemeService 会按用户选择覆盖 -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="AppAccentColor">#2E7CF6</Color>
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#2E7CF6"/>
                    <SolidColorBrush x:Key="AppPageBackground" Color="#F7F8FA"/>
                    <SolidColorBrush x:Key="AppSidebarBackground" Color="#EDEFF3"/>
                    <SolidColorBrush x:Key="AppSidebarHover" Color="#E2E6EE"/>
                    <SolidColorBrush x:Key="AppSidebarSelected" Color="#D8E4FB"/>
                    <SolidColorBrush x:Key="AppCardBackground" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="AppCardBorder" Color="#E3E6EC"/>
                    <SolidColorBrush x:Key="AppTextSecondary" Color="#66666E"/>
                    <SolidColorBrush x:Key="AppPredownloadBadge" Color="#E8930C"/>
                    <SolidColorBrush x:Key="AppErrorText" Color="#C42B1C"/>
                    <SolidColorBrush x:Key="AppStatusOk" Color="#2DA44E"/>
                    <!-- 详情页背景图上的暗化遮罩：顶部保证文字对比，底部融入页面背景 -->
                    <Color x:Key="AppDetailScrimTopColor">#B3E6EDF3</Color>
                    <Color x:Key="AppDetailScrimBottomColor">#F7F8FA</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="AppAccentColor">#4C8DFF</Color>
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#4C8DFF"/>
                    <SolidColorBrush x:Key="AppPageBackground" Color="#121216"/>
                    <SolidColorBrush x:Key="AppSidebarBackground" Color="#1A1A20"/>
                    <SolidColorBrush x:Key="AppSidebarHover" Color="#24242C"/>
                    <SolidColorBrush x:Key="AppSidebarSelected" Color="#2B3A5C"/>
                    <SolidColorBrush x:Key="AppCardBackground" Color="#23232B"/>
                    <SolidColorBrush x:Key="AppCardBorder" Color="#2E2E38"/>
                    <SolidColorBrush x:Key="AppTextSecondary" Color="#A2A2AB"/>
                    <SolidColorBrush x:Key="AppPredownloadBadge" Color="#E8930C"/>
                    <SolidColorBrush x:Key="AppErrorText" Color="#FF8A7A"/>
                    <SolidColorBrush x:Key="AppStatusOk" Color="#3FB950"/>
                    <Color x:Key="AppDetailScrimTopColor">#B314141A</Color>
                    <Color x:Key="AppDetailScrimBottomColor">#121216</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme/>
    </Application.Styles>
</Application>
