<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:YetAnotherGameLauncher.ViewModels"
        xmlns:controls="using:YetAnotherGameLauncher.Controls"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
        x:Class="YetAnotherGameLauncher.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Icon="avares://YetAnotherGameLauncher/Assets/app-icon.ico"
        Width="1464" Height="720" MinWidth="920" MinHeight="620"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI, PingFang SC, Noto Sans CJK SC, Source Han Sans CN, Source Han Sans SC, WenQuanYi Zen Hei, Segoe UI, Inter">

    <Window.Styles>
        <!-- 侧栏列表项：圆角、悬停/选中为弱化强调（左内边距给选中指示点留位，图标不贴点） -->
        <Style Selector="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSidebarHover}"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSidebarSelected}"/>
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSidebarSelected}"/>
        </Style>

        <!-- 状态点：默认灰，可启动绿，有更新强调蓝，预下载窗口琥珀（限时的可选动作） -->
        <Style Selector="Ellipse.dot">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="{DynamicResource AppTextSecondary}"/>
        </Style>
        <Style Selector="Ellipse.dot.installed">
            <Setter Property="Fill" Value="{DynamicResource AppStatusOk}"/>
        </Style>
        <Style Selector="Ellipse.dot.has-update">
            <Setter Property="Fill" Value="{DynamicResource AppAccentBrush}"/>
        </Style>
        <Style Selector="Ellipse.dot.predownload">
            <Setter Property="Fill" Value="{DynamicResource AppPredownloadBadge}"/>
        </Style>

        <!-- 玻璃卡片（浮在窗口背景上） -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource AppCardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style Selector="TextBlock.card-caption">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
        </Style>

        <!-- 表单保存结果提示：绿色成功 / 红色失败（文本空白时由 HasMessage 隐藏） -->
        <Style Selector="TextBlock.save-msg">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource AppStatusOk}"/>
        </Style>
        <Style Selector="TextBlock.save-msg.failed">
            <Setter Property="Foreground" Value="{DynamicResource AppErrorText}"/>
        </Style>

        <!-- 常用按钮规格：小号操作钮与返回钮 -->
        <Style Selector="Button.btn-sm">
            <Setter Property="Padding" Value="16,8"/>
        </Style>
        <Style Selector="Button.back-btn">
            <Setter Property="Padding" Value="20,9"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <!-- 设置卡片上的次级按钮：底色取悬停色与卡片明确区分（曾与卡片同色而"隐形"），描边沿用卡片边框色 -->
        <Style Selector="Button.glass">
            <Setter Property="Background" Value="{DynamicResource AppSidebarHover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.glass /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSidebarHover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style Selector="Button.glass:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSidebarSelected}"/>
        </Style>

        <!-- 插画上的玻璃按钮：固定暗色半透明底 + 浅色字（详情页暗遮罩方案，两主题一致）。
             前景必须设在模板 presenter 层：Fluent 的 :pointerover/:pressed/:disabled 状态样式
             都在 presenter 上写主题前景（亮色主题为黑/灰），会压过 Button 本体上的浅色字 -->
        <Style Selector="Button.glass-onart">
            <Setter Property="Background" Value="{DynamicResource AppOnArtworkCard}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppOnArtworkBrush}"/>
        </Style>
        <Style Selector="Button.glass-onart /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppOnArtworkCard}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource AppOnArtworkBrush}"/>
        </Style>
        <Style Selector="Button.glass-onart:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppOnArtworkCardHover}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppOnArtworkBrush}"/>
        </Style>
        <Style Selector="Button.glass-onart:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppOnArtworkCard}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppOnArtworkBrush}"/>
        </Style>
        <Style Selector="Button.glass-onart:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppOnArtworkCard}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppOnArtworkSecondary}"/>
        </Style>

        <!-- 海报上的主题色主操作按钮：accent 底 + 白字；四态下沉 presenter（同 glass-onart 规则） -->
        <Style Selector="Button.accent-onart">
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.accent-onart /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.accent-onart:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppAccentHoverBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.accent-onart:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppAccentHoverBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.accent-onart:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppOnArtworkCard}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppOnArtworkSecondary}"/>
        </Style>

        <!-- 危险确认按钮（插画上语境，评审 P1-3）：红字 + 红描边 + 近实心暗底，不用红底大按钮——
             破坏性操作（覆盖重装）不得与建设性主操作共用 accent 实心样式。
             四态下沉 presenter（同 accent-onart 规则）；底必须近实心，否则透白海报红字不达门禁 -->
        <Style Selector="Button.danger-onart">
            <Setter Property="Background" Value="{DynamicResource AppOnArtworkCardStrong}"/>
            <Setter Property="BorderBrush" Value="#8CFF8A7A"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="{DynamicResource AppOnArtworkErrorBrush}"/>
        </Style>
        <Style Selector="Button.danger-onart /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppOnArtworkCardStrong}"/>
            <Setter Property="BorderBrush" Value="#8CFF8A7A"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource AppOnArtworkErrorBrush}"/>
        </Style>
        <Style Selector="Button.danger-onart:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppOnArtworkCardStrong}"/>
            <Setter Property="BorderBrush" Value="#FFFF8A7A"/>
            <Setter Property="Foreground" Value="{DynamicResource AppOnArtworkErrorBrush}"/>
        </Style>
        <Style Selector="Button.danger-onart:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FF202029"/>
            <Setter Property="BorderBrush" Value="#FFFF8A7A"/>
            <Setter Property="Foreground" Value="{DynamicResource AppOnArtworkErrorBrush}"/>
        </Style>
        <Style Selector="Button.danger-onart:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppOnArtworkCard}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppOnArtworkSecondary}"/>
        </Style>

        <!-- 危险确认按钮（错误卡语境，评审 P1-3）：红字红描边幽灵钮 + 悬停淡红染——
             与 danger-onart 同语义，但底透出错误卡面（AppErrorCardBackground），前景走主题化 AppErrorText -->
        <Style Selector="Button.danger-card">
            <Setter Property="Padding" Value="24,8"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppErrorText}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="{DynamicResource AppErrorText}"/>
        </Style>
        <Style Selector="Button.danger-card /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppErrorText}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource AppErrorText}"/>
        </Style>
        <Style Selector="Button.danger-card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppDangerWashHover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppErrorText}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppErrorText}"/>
        </Style>
        <Style Selector="Button.danger-card:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppDangerWashPressed}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppErrorText}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppErrorText}"/>
        </Style>
        <Style Selector="Button.danger-card:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppErrorText}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppErrorText}"/>
            <Setter Property="Opacity" Value="0.4"/>
        </Style>

        <!-- 预下载专用按钮：琥珀描边（AppPredownloadBadge 语义色，与已暂存徽章同源），
             悬停染琥珀底——预下载窗口期内"弹出"提示，又不与启动/安装的实心 accent 抢主 CTA。
             四态同样下沉 presenter 层（同 glass-onart 规则） -->
        <Style Selector="Button.predownload-onart">
            <Setter Property="Background" Value="#26000000"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppPredownloadBadge}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Foreground" Value="{DynamicResource AppOnArtworkBrush}"/>
        </Style>
        <Style Selector="Button.predownload-onart /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#26000000"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppPredownloadBadge}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource AppOnArtworkBrush}"/>
        </Style>
        <Style Selector="Button.predownload-onart:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#5CE8930C"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.predownload-onart:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#80E8930C"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.predownload-onart:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppOnArtworkCard}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AppOnArtworkSecondary}"/>
        </Style>

        <!-- 唤取入口图标钮：常显玻璃底胶囊——次级功能但需要被看见，不与主 CTA 争夺 -->
        <Style Selector="Button.gacha-onart">
            <Setter Property="Background" Value="{DynamicResource AppOnArtworkCard}"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource AppOnArtworkBrush}"/>
        </Style>
        <Style Selector="Button.gacha-onart /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppOnArtworkCard}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource AppOnArtworkBrush}"/>
        </Style>
        <Style Selector="Button.gacha-onart:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppOnArtworkCardHover}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppOnArtworkBrush}"/>
        </Style>
        <Style Selector="Button.gacha-onart:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppOnArtworkCard}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppOnArtworkBrush}"/>
        </Style>

        <!-- 详情页底部操作坞：通栏玻璃条，收拢信息列与全部按钮（原按钮行/进度卡/页脚三行合并于此） -->
        <Style Selector="Border.action-dock">
            <Setter Property="Background" Value="{DynamicResource AppOnArtworkDockBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppOnArtworkCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18,12"/>
        </Style>
        <Style Selector="TextBlock.dock-caption">
            <!-- 方案 A .info i：12px 三级弱化标签，比值列暗一档撑起层级（11px 过小，评审 P2-7） -->
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource AppOnArtworkTertiary}"/>
        </Style>

        <!-- 详情页顶部 chips（方案 A）：插画上的胶囊族（状态/版本），自带 1px 轮廓 -->
        <Style Selector="Border.onart-chip">
            <Setter Property="Background" Value="{DynamicResource AppOnArtworkCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppOnArtworkCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16,8"/>
        </Style>

        <!-- 唤取记录稀有度：五星金 / 四星紫（成对令牌，对比度门禁 ThemeTokenContrastTests 管辖） -->
        <Style Selector="TextBlock.gacha-rare5">
            <Setter Property="Foreground" Value="{DynamicResource AppGachaRare5}"/>
        </Style>
        <Style Selector="TextBlock.gacha-rare4">
            <Setter Property="Foreground" Value="{DynamicResource AppGachaRare4}"/>
        </Style>

        <!-- 图标按钮 -->
        <Style Selector="Button.icon-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.icon-btn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.icon-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSidebarHover}"/>
        </Style>
        <!-- 幽灵图标按钮（关于页项目主页出口）：信息卡纯文本行内的链接型出口——
             无底无边框不打断文本节奏，辅助色常态、hover 显微亮底并转强调色（链接语义）；
             前景写在 Button 上即可：内部 Path 的 Fill 显式绑定 $parent[Button].Foreground，
             不走继承，不受 Fluent presenter 状态前景压制 -->
        <Style Selector="Button.ghost-home">
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
        </Style>
        <Style Selector="Button.ghost-home:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}"/>
        </Style>

        <!-- 设置/关于导航项：当前页对应的入口与游戏列表同色高亮。
             展开态内边距/左对齐必须走样式而非按钮本地值——本地值优先级压过下方收缩覆盖，
             收缩态图标居中从未生效过（2026-09-25 实锤修复） -->
        <Style Selector="Button.nav-item">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style Selector="Button.nav-item.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSidebarSelected}"/>
        </Style>

        <!-- 非游戏页时抑制游戏列表的选中高亮（导航高亮让位给设置/关于入口） -->
        <Style Selector="ListBox.nav-inactive ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.nav-inactive ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- 按下微缩 -->
        <Style Selector="Button.pressable">
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08"/>
                </Transitions>
            </Setter>
            <Style Selector="^:pressed">
                <Setter Property="RenderTransform" Value="scale(0.97)"/>
            </Style>
        </Style>

        <!-- 侧栏收起态：条目与导航钮图标居中（Padding 3 对称、图标盒居中于侧栏中线）。
             注意：选中高亮背景=ContentPresenter 区域，不随 Item 负 Margin 溢出扩展
             （实测 Margin -6 只撑大 bounds、背景仍 44 宽）——指示点因此贴块内左缘、
             与图标盒左缘相切（仅叠 2px），与展开态同一"点在块内"语言 -->
        <Style Selector="Border.game-sidebar.collapsed ListBoxItem">
            <Setter Property="Padding" Value="3"/>
        </Style>
        <Style Selector="Border.game-sidebar.collapsed Button.icon-btn">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

        <!-- 页面切换：Store 式横滑过渡（前进自右滑入、后退自左滑入，配淡入）；
             详情页根为 Panel 无边距，设置类页根为 Border.page 统一留边 -->

        <!-- 设置类页面（设置/关于/游戏设置）的统一页边距（顶部避开 46px 标题色带） -->
        <Style Selector="Border.page">
            <Setter Property="Margin" Value="32,48,32,24"/>
        </Style>
        <Style Selector="ContentControl.nav-forward :is(Control).page">
            <Style.Animations>
                <Animation Duration="0:0:0.3" FillMode="Forward" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="TranslateTransform.X" Value="56"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="TranslateTransform.X" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="ContentControl.nav-back :is(Control).page">
            <Style.Animations>
                <Animation Duration="0:0:0.3" FillMode="Forward" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="TranslateTransform.X" Value="-56"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="TranslateTransform.X" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- 圆角内容浮卡（游戏插画等全部裁剪在内）；左上圆角是侧栏与内容卡之间的内部角，
             不贴屏幕边——最大化时也保留（去圆角仅窗口外缘两角做） -->
        <!-- 内容容器：透明底——设置类页面直接浮在应用背景（渐变+光晕）上；
             详情页的插画在页面模板内自带背景。仅负责裁剪与（详情态）圆角 -->
        <!-- 页面板（所有页面统一，同详情页海报）：从色带下方开始、左上角 10px 圆角、
             右/下/左贴边全出血（其余角由窗口圆角负责）；内部自带应用背景层，
             设置/关于的半透明卡片浮在它上面，详情页海报照旧覆盖全板 -->
        <Style Selector="Border.content-card">
            <Setter Property="CornerRadius" Value="10,0,0,0"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Margin" Value="0,46,0,0"/>
        </Style>
        <!-- 标题拖拽区：覆盖色带整条（46px），所有页面一致 -->
        <Style Selector="Border.title-drag">
            <Setter Property="Height" Value="46"/>
        </Style>

        <!-- 窗口顶部两角圆角（左上=侧栏、右上=标题色带）；最大化时铺满屏幕应去掉 -->
        <Style Selector="Border.game-sidebar">
            <Setter Property="CornerRadius" Value="10,0,0,0"/>
        </Style>
        <Style Selector="Border.game-sidebar.maximized">
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="Border#TitleChrome">
            <Setter Property="CornerRadius" Value="0,10,0,0"/>
        </Style>
        <Style Selector="Border#TitleChrome.maximized">
            <Setter Property="CornerRadius" Value="0"/>
        </Style>

        <!-- 自绘标题栏按钮：最小化/最大化/关闭（关闭悬停红色，Win11 习惯） -->
        <!-- 最大化钮 tooltip 随窗口态切换（window_restore 键此前是孤儿资源，2026-09-20 接线） -->
        <Style Selector="Button#CaptionMaximize">
            <Setter Property="ToolTip.Tip" Value="{Binding Loc[window_maximize]}"/>
        </Style>
        <Style Selector="Button#CaptionMaximize.maximized">
            <Setter Property="ToolTip.Tip" Value="{Binding Loc[window_restore]}"/>
        </Style>
        <Style Selector="Button.caption-btn">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.caption-btn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.caption-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSidebarHover}"/>
        </Style>
        <Style Selector="Button.caption-btn.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E81123"/>
        </Style>
        <Style Selector="Button.caption-btn.close:pointerover">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- ========== 轻提示气泡（右上角瞬态信息：版本检测结果/检测到游戏） ========== -->
        <Style Selector="Border.toast-card">
            <!-- 近实心专属底（方案 A toast .94）；不用共享 AppCardBackground（太透）。
                 层次靠 1px 描边 + 近实心底，不用 BoxShadow：真机渲染管线（原生 Wayland +
                 NVIDIA + HDR 输出）会把模糊阴影呈成边缘生硬的灰色矩形板（2026-09-17 实锤，
                 headless 截图反而正常）——细节见 AGENTS.md -->
            <Setter Property="Background" Value="{DynamicResource AppToastBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="MinWidth" Value="260"/>
            <Setter Property="MaxWidth" Value="360"/>
        </Style>
        <Style Selector="Border.toast-card TextBlock.toast-title">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Border.toast-card TextBlock.toast-message">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
            <Setter Property="LineHeight" Value="18"/>
        </Style>
        <Style Selector="Border.toast-card Ellipse.toast-dot">
            <Setter Property="Fill" Value="{DynamicResource AppAccentBrush}"/>
        </Style>
        <Style Selector="Border.toast-card.toast-success Ellipse.toast-dot">
            <Setter Property="Fill" Value="{DynamicResource AppStatusOk}"/>
        </Style>
        <Style Selector="Border.toast-card.toast-warning Ellipse.toast-dot">
            <Setter Property="Fill" Value="{DynamicResource AppPredownloadBadge}"/>
        </Style>
        <!-- Toast 关闭钮：幽灵图标钮（透明圆底 + 线条 X，hover 浮现浅圆底，pressed 加深一档） -->
        <Style Selector="Button.toast-close">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
        </Style>
        <Style Selector="Button.toast-close /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.toast-close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSidebarHover}"/>
        </Style>
        <Style Selector="Button.toast-close:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppCardBorder}"/>
        </Style>

        <!-- ========== 启动失败覆盖层（详情页内）：纱罩 + 错误卡 + accent 关闭钮 ========== -->
        <Style Selector="Border.launch-error-card">
            <Setter Property="Background" Value="{DynamicResource AppErrorCardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
            <!-- 无 BoxShadow：真机 HDR 路径会把模糊阴影呈成硬边矩形板（同 toast-card，见 AGENTS.md） -->
        </Style>
        <!-- 主操作钮走 accent：Fluent 在 presenter 层逐状态设背景，这里同样下沉覆盖（含前景） -->
        <Style Selector="Button.launch-error-primary">
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="24,8"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>
        <Style Selector="Button.launch-error-primary /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style Selector="Button.launch-error-primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppAccentHoverBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.launch-error-primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppAccentHoverBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Opacity" Value="0.9"/>
        </Style>
        <Style Selector="Button.launch-error-primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Opacity" Value="0.4"/>
        </Style>
        <Style Selector="Button.launch-error-secondary">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>
    </Window.Styles>

    <!-- ==================== 窗口级结构：应用自有背景 → 主布局（游戏背景只在详情页模板内） ==================== -->
    <Panel>

        <controls:AppBackdrop GlowMargin="0,46,0,0"/>

        <Grid ColumnDefinitions="Auto,*">

            <!-- ==================== 侧边栏（与标题区同色一体，无分隔线；可缩放 264 ↔ 68） ==================== -->
            <Border Grid.Column="0" Classes="game-sidebar"
                    Width="{Binding SidebarWidth}"
                    Classes.collapsed="{Binding !IsSidebarExpanded}"
                    Classes.maximized="{Binding IsWindowMaximized}"
                    Background="{DynamicResource AppSidebarBackground}">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Width" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                    </Transitions>
                </Border.Transitions>
                <Panel>
                    <DockPanel Margin="12,16,12,12" LastChildFill="True">

                    <!-- 顶部：展开态 = logo + 标题 + 折叠（logo 区兼任自绘标题栏的拖拽区） -->
                    <StackPanel DockPanel.Dock="Top">
                        <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding IsSidebarExpanded}"
                              PointerPressed="OnTitlePointerPressed" DoubleTapped="OnTitleDoubleTapped">
                            <Image Width="38" Height="38"
                                   Source="avares://YetAnotherGameLauncher/Assets/app-icon.png"/>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="0">
                                <TextBlock Text="YetAnother" FontSize="20" FontWeight="Bold" Opacity="0.85"/>
                                <TextBlock Text="Game Launcher" FontSize="20" FontWeight="Bold"
                                           Foreground="{DynamicResource AppAccentBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="2" Classes="icon-btn pressable" Command="{Binding ToggleSidebarCommand}"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="{Binding Loc[sidebar_expanded_collapse]}">
                                <Path Data="M10.4 6.6 4.9 12l5.5 5.4 1.5-1.4-4.1-4 4.1-4zM16.9 6.6 11.4 12l5.5 5.4 1.5-1.4-4.1-4 4.1-4z"
                                      Fill="{Binding $parent[Button].Foreground}"
                                      Stretch="Uniform" Width="16" Height="16"/>
                            </Button>
                        </Grid>
                        <!-- 收起态顶部：仅 app logo（点击展开侧栏） -->
                        <Button Classes="icon-btn pressable" Command="{Binding ToggleSidebarCommand}"
                                IsVisible="{Binding !IsSidebarExpanded}"
                                HorizontalAlignment="Center" Padding="4"
                                ToolTip.Tip="{Binding Loc[sidebar_collapsed_expand]}">
                            <Image Width="38" Height="38"
                                   Source="avares://YetAnotherGameLauncher/Assets/app-icon.png"/>
                        </Button>
                    </StackPanel>

                    <!-- 计数与状态提示（收起时隐藏） -->
                    <StackPanel DockPanel.Dock="Top" IsVisible="{Binding IsSidebarExpanded}" Margin="6,12,4,0" Spacing="4">
                        <TextBlock Text="{Binding GameCountText}" FontSize="12"
                                   Foreground="{DynamicResource AppTextSecondary}"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource AppErrorText}" IsVisible="{Binding ConfigError}"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource AppTextSecondary}" IsVisible="{Binding ShowStatusAsHint}"/>
                    </StackPanel>

                    <!-- 底部：设置 / 关于（x:Name 供选中指示点定位） -->
                    <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,12,0,0">
                        <Button x:Name="SettingsNavButton" Classes="icon-btn pressable nav-item" Command="{Binding ShowSettingsCommand}"
                                Classes.selected="{Binding IsSettingsNavActive}"
                                HorizontalAlignment="Stretch"
                                ToolTip.Tip="{Binding Loc[common_settings]}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Path Data="{StaticResource GearIconGeo}"
                                      Fill="{Binding $parent[Button].Foreground}"
                                      Stretch="Uniform" Width="18" Height="18"
                                      HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding Loc[common_settings]}"
                                           FontSize="13" VerticalAlignment="Center"
                                           IsVisible="{Binding IsSidebarExpanded}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="AboutNavButton" Classes="icon-btn pressable nav-item" Command="{Binding ShowAboutCommand}"
                                Classes.selected="{Binding IsAboutNavActive}"
                                HorizontalAlignment="Stretch"
                                ToolTip.Tip="{Binding Loc[common_about]}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"
                                      Fill="{Binding $parent[Button].Foreground}"
                                      Stretch="Uniform" Width="18" Height="18"
                                      HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding Loc[common_about]}"
                                           FontSize="13" VerticalAlignment="Center"
                                           IsVisible="{Binding IsSidebarExpanded}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 游戏列表（非游戏页时高亮让位给设置/关于，选中项经 GameNavSelection 转发） -->
                    <ListBox x:Name="GamesList"
                             ItemsSource="{Binding Games}"
                             SelectedItem="{Binding GameNavSelection}"
                             Classes.nav-inactive="{Binding !IsGameNavActive}"
                             Background="Transparent" BorderThickness="0" Margin="0,16,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:GameItemViewModel">
                                        <Grid ColumnDefinitions="Auto,*,Auto"
                                              ToolTip.Tip="{Binding DisplayName}">
                                    <Border Width="38" Height="38" CornerRadius="10" ClipToBounds="True"
                                            Background="{DynamicResource AppAccentBrush}">
                                        <Panel>
                                            <Image Source="{Binding GameIcon}" Stretch="UniformToFill"
                                                   IsVisible="{Binding HasGameIcon}"/>
                                            <TextBlock Text="{Binding IconText}" FontSize="18" FontWeight="SemiBold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       IsVisible="{Binding !HasGameIcon}"/>
                                        </Panel>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2"
                                                IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsSidebarExpanded}">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="14"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding SidebarStatusText}" FontSize="12"
                                                   Foreground="{DynamicResource AppTextSecondary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Ellipse Grid.Column="2" Classes="dot" VerticalAlignment="Center"
                                             IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsSidebarExpanded}"
                                             Classes.installed="{Binding CanLaunch}"
                                             Classes.has-update="{Binding HasUpdate}"
                                             Classes.predownload="{Binding ShowPredownloadCue}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    </DockPanel>

            <!-- 侧栏选中指示点：两态静息于选中块内部左缘（展开态内缩 3px、收起态贴块左缘），选中项变更时
                 沿行进方向变长一倍 → 快速跳到新项 → 收缩落位（编舞在代码后置，X 由 MoveNavIndicator 直接定位） -->
            <Border x:Name="NavIndicator"
                    Width="5" CornerRadius="2.5"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="{DynamicResource AppAccentBrush}"
                            IsHitTestVisible="False" IsVisible="False"
                            RenderTransformOrigin="0,0"
                            BoxShadow="0 0 8 #592E68E0">
                        <Border.RenderTransform>
                            <!-- 子顺序即语义：先 Scale 后 Translate（原点 0,0）→ 视觉区间 [TranslateY, TranslateY+Height×ScaleY]；
                                 若反过来写，平移量会被缩放系数压缩（指示点首个版本错位的根因）。
                                 变换不生成 x:Name 字段（AVLN2000），代码后置按声明顺序解析 -->
                            <TransformGroup>
                                <ScaleTransform/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Border.RenderTransform>
                    </Border>
                </Panel>
            </Border>

            <!-- ==================== 主内容列：顶部标题色带（与侧栏同色，自绘标题钮位于其上）+
                 页面板（所有页面统一：色带下方开始、左上角圆角、贴边全出血） ==================== -->
            <Grid Grid.Column="1">
                <!-- 色带高 56 = 46 可见 + 10px 延伸到页面板圆角后方：
                     圆角缺口处露出色带颜色而非更深的底层背景（暗色主题下曾呈"多一层"方角） -->
                <Border x:Name="TitleChrome" Height="56" VerticalAlignment="Top"
                        Classes.maximized="{Binding IsWindowMaximized}"
                        Background="{DynamicResource AppSidebarBackground}" IsHitTestVisible="False"/>
                <Border x:Name="ContentCard" Classes="content-card">
                    <Panel>
                        <!-- 页面底：应用背景随页面板圆角裁剪，详情页海报照旧覆盖全板 -->
                        <controls:AppBackdrop/>
                        <ContentControl x:Name="PageHost" Content="{Binding CurrentPage}"
                                        Classes.nav-forward="{Binding !IsNavBack}"
                                        Classes.nav-back="{Binding IsNavBack}">
                        <ContentControl.DataTemplates>

                            <!-- ========== 游戏详情页（海报式：游戏当期背景铺满主区域，仅此页） ========== -->
                            <DataTemplate DataType="{x:Type vm:GameItemViewModel}">
                                <!-- ClipToBounds：插画只属于内容卡片，不外溢到侧栏底下 -->
                                <Panel Classes="page" ClipToBounds="True">

                                    <!-- 游戏当期背景：静态海报（加载前占位）→ 视频层（首帧到达后接管），无遮罩完整呈现。
                                         左上锚定：UniformToFill 的溢出只裁右侧/底部，海报左缘完整贴住侧栏不被裁切 -->
                                    <Image x:Name="PosterImage" Source="{Binding BackgroundImage}" Stretch="UniformToFill"
                                           HorizontalAlignment="Left" VerticalAlignment="Top"
                                           IsVisible="{Binding HasBackgroundImage}"/>
                                    <!-- FrameSurface 必须保持默认 Stretch 铺满 Panel——裸控件设 Left/Top
                                         对齐会测量出 0×0，Render 永远画不出（曾致视频不显示） -->
                                    <controls:FrameSurface Player="{Binding VideoPlayer}"
                                                           IsVisible="{Binding HasBackgroundVideo}"/>

                                    <!-- 无插画回退：固定深色渐变底 + 官方图标水印。
                                         空态设计（desktop-ui-design §5）：官方未投放背景/缓存缺失时，
                                         详情页仍是"这个游戏"的页面而非黑屏；图标缺失时优雅降级为纯渐变。
                                         可见性必须同时看「无海报」「无视频」：本层在 z 序上位于视频层之上，
                                         只看海报会让"海报缺失但视频在播"被整面不透明渐变盖住（2026-09-25 修复） -->
                                    <Grid x:Name="ArtworkFallback">
                                        <Grid.IsVisible>
                                            <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                                                <Binding Path="!HasBackgroundImage"/>
                                                <Binding Path="!HasBackgroundVideo"/>
                                            </MultiBinding>
                                        </Grid.IsVisible>
                                        <Border>
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                                    <GradientStop Color="#232B3A" Offset="0"/>
                                                    <GradientStop Color="#0D1017" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Image Source="{Binding GameIcon}" IsVisible="{Binding HasGameIcon}"
                                               Stretch="Uniform" MaxWidth="380" MaxHeight="380"
                                               HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                               Margin="0,0,56,72" Opacity="0.13"/>
                                    </Grid>

                                    <!-- 顶部渐变纱带（方案 A .ch）：chips 的可读底，全出血、不拦交互。
                                         固定 140：chips 行位置不随窗口缩放（顶部固定边距簇），
                                         固定高恰好覆盖；2026-09-25 曾为压官方烧录 Logo 加深加高，
                                         随自绘标题移除（与背景 Logo 字标重复打架）回调轻量版 -->
                                    <Border Height="140" VerticalAlignment="Top" IsHitTestVisible="False"
                                            Background="{DynamicResource AppOnArtworkScrimBrush}"/>

                                    <Grid RowDefinitions="*,Auto" Margin="16,36,16,16">

                                        <!-- 顶部信息簇（方案 A，左对齐）：chips 行 → 确认条 → 空态卡。
                                             左缩进 12 = 距内容卡左缘 28px。自绘游戏名标题已移除
                                             （2026-09-25 用户决定：官方背景左上角自带烧录 Logo 字标，
                                             自绘标题与之重复打架且无法稳定避让；识别职责由窗口
                                             标题"游戏名 · 应用名"与侧栏选中项承担） -->
                                        <StackPanel Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Left"
                                                    Margin="12,12,0,0" Spacing="16">
                                            <!-- 校验修复确认条（包式渠道无逐文件清单：修复=整包重下覆盖安装，需确认）；
                                                 无 BoxShadow：真机 HDR 路径会把模糊阴影呈成硬边矩形板（同 toast-card） -->
                                            <Border HorizontalAlignment="Left"
                                                    Padding="16,12" CornerRadius="12"
                                                    Background="{DynamicResource AppOnArtworkCard}"
                                                    BorderBrush="{DynamicResource AppOnArtworkCardBorder}"
                                                    BorderThickness="1"
                                                    IsVisible="{Binding ShowRepairConfirm}">
                                                <StackPanel Orientation="Horizontal" Spacing="16">
                                                    <TextBlock Text="{Binding RepairConfirmText}" MaxWidth="430"
                                                               TextWrapping="Wrap" FontSize="13"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource AppOnArtworkBrush}"/>
                                                     <Button Classes="btn-sm pressable danger-onart"
                                                             Content="{Binding Loc[verify_confirm_yes]}"
                                                             Command="{Binding ConfirmRepairCommand}"
                                                             VerticalAlignment="Center"/>
                                                    <Button Classes="btn-sm pressable glass-onart"
                                                            Content="{Binding Loc[verify_confirm_no]}"
                                                            Command="{Binding CancelRepairCommand}"
                                                            VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <!-- chips 行：状态 + 已暂存徽章 + 版本迁移（金色数字段）。
                                                 WrapPanel 限宽 640：长状态文案挤不下时后续 chip 换行而非裁剪/
                                                 溢出内容卡（水平 StackPanel 只会原样溢出，窄窗口下被裁）；
                                                 StatusText 另有 MaxWidth=430 换行，双保险 -->
                                            <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8"
                                                       MaxWidth="640">
                                                <Border Classes="onart-chip" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Ellipse Classes="dot" Width="11" Height="11" VerticalAlignment="Center"
                                                                 Classes.installed="{Binding CanLaunch}"
                                                                 Classes.has-update="{Binding HasUpdate}"
                                                                 Classes.predownload="{Binding ShowPredownloadCue}"/>
                                                        <TextBlock Text="{Binding StatusText}" FontSize="14" FontWeight="SemiBold"
                                                                   MaxWidth="430" TextWrapping="Wrap"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource AppOnArtworkBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Padding="12,4" CornerRadius="14" VerticalAlignment="Center"
                                                        Background="{DynamicResource AppPredownloadBadge}"
                                                        IsVisible="{Binding HasStagedPredownload}">
                                                    <TextBlock Text="{Binding Loc[game_stagedBadge]}" FontSize="12"
                                                               Foreground="{DynamicResource AppPredownloadBadgeText}"/>
                                                </Border>
                                                <!-- 版本 chip：前导 + 金色号码（+ 迁移中段 + 金色目标号码），独立胶囊 -->
                                                <Border Padding="12,4" CornerRadius="14" VerticalAlignment="Center"
                                                        Background="{DynamicResource AppVersionChipBackground}">
                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding VersionChipLead}" FontSize="13"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource AppVersionChipText}"/>
                                                        <TextBlock Text="{Binding VersionChipNumber}" FontSize="13" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource AppVersionChipAccent}"/>
                                                        <TextBlock Text="{Binding VersionChipMid}" FontSize="13"
                                                                   VerticalAlignment="Center"
                                                                   IsVisible="{Binding VersionChipMid, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                                                   Foreground="{DynamicResource AppVersionChipText}"/>
                                                        <TextBlock Text="{Binding VersionChipTarget}" FontSize="13" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   IsVisible="{Binding VersionChipTarget, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                                                   Foreground="{DynamicResource AppVersionChipAccent}"/>
                                                    </StackPanel>
                                                </Border>
                                            </WrapPanel>

                                            <!-- 未安装空态引导卡（评审 P1-2：空态要设计、禁用钮说明原因）：
                                                 用现有数据（渠道/最新版本/服务器/安装目录）组装，
                                                 与确认条同款玻璃卡；已安装即隐藏 -->
                                            <Border x:Name="EmptyStateCard"
                                                    HorizontalAlignment="Left" MaxWidth="480"
                                                    Padding="16,12" CornerRadius="12"
                                                    Background="{DynamicResource AppOnArtworkCard}"
                                                    BorderBrush="{DynamicResource AppOnArtworkCardBorder}"
                                                    BorderThickness="1"
                                                    IsVisible="{Binding ShowEmptyState}">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="{Binding Loc[detail_emptyTitle]}"
                                                               FontSize="15" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AppOnArtworkBrush}"/>
                                                    <TextBlock Text="{Binding Loc[detail_emptyHint]}"
                                                               FontSize="13" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource AppOnArtworkSecondary}"/>
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Loc[game_info_channel]}"
                                                                   Classes="dock-caption" LineHeight="22" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding ChannelDisplayName}"
                                                                   FontSize="13" LineHeight="22" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource AppOnArtworkBrush}"/>
                                                    </Grid>
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                                        <TextBlock Text="{Binding Loc[version_label_latest]}"
                                                                   Classes="dock-caption" LineHeight="22" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding VersionChipNumber}"
                                                                   FontSize="13" LineHeight="22" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource AppOnArtworkBrush}"/>
                                                    </Grid>
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                                        <TextBlock Text="{Binding Loc[game_server]}"
                                                                   Classes="dock-caption" LineHeight="22" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding ServerCountText}"
                                                                   FontSize="13" LineHeight="22" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource AppOnArtworkBrush}"/>
                                                    </Grid>
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                                        <TextBlock Text="{Binding Loc[game_info_installDir]}"
                                                                   Classes="dock-caption" LineHeight="22" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding InstallDirPath}"
                                                                   FontSize="13" LineHeight="22"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip.Tip="{Binding InstallDirPath}"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource AppOnArtworkBrush}"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- 底部操作坞（通栏玻璃条）：左列渠道/目录信息（busy 时变进度条），
                                             右列按钮按"图标 → 次级 → 主 CTA 最右"排布——原按钮行/进度卡/页脚三行合并于此 -->
                                        <controls:DetailActionDock Grid.Row="1"/>

                                    </Grid>

                                    <!-- 启动失败覆盖层：类目化原因 + 技术详情 + 日志入口 + umu 引导安装 -->
                                    <controls:LaunchErrorOverlay/>
                                </Panel>
                            </DataTemplate>

                            <!-- ========== 设置页 ========== -->
                            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                                <controls:SettingsPage/>
                            </DataTemplate>

                            <!-- ========== 关于页 ========== -->
                            <DataTemplate DataType="{x:Type vm:AboutViewModel}">
                                <controls:AboutPage/>
                            </DataTemplate>

                            <!-- ========== 唤取记录页（鸣潮专属） ========== -->
                            <DataTemplate DataType="{x:Type vm:GachaViewModel}">
                                <controls:GachaPage/>
                            </DataTemplate>

                            <!-- ========== 游戏设置页（Motrix 式分区） ========== -->
                            <DataTemplate DataType="{x:Type vm:GameSettingsViewModel}">
                                <controls:GameSettingsPage/>
                            </DataTemplate>

                        </ContentControl.DataTemplates>
                    </ContentControl>
                    </Panel>
                </Border>
                <!-- 自绘标题栏拖拽区：覆盖色带整条 46px（按钮在下层无交互内容；侧栏 logo 区拖拽挂在 logo 网格上） -->
                <Border x:Name="TitleDrag" Classes="title-drag" VerticalAlignment="Top" Background="Transparent"
                        PointerPressed="OnTitlePointerPressed" DoubleTapped="OnTitleDoubleTapped"/>
            </Grid>
        </Grid>

        <!-- 轻提示宿主：右上角、标题钮下方（瞬态信息：版本检测结果/检测到游戏）；
             仅卡片可点（宿主无背景不参与命中，空隙穿透；勿设 IsHitTestVisible=False，会剪掉整棵子树） -->
        <controls:ToastHost HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,52,12,0"/>

        <!-- 自绘标题栏：右上三钮（覆盖在内容卡片之上；图标随最大化/还原切换） -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,8,0">
            <Button x:Name="CaptionMinimize" Classes="caption-btn" Click="OnMinimizeClick"
                    ToolTip.Tip="{Binding Loc[window_minimize]}">
                <Path Data="M 1 5.5 L 11 5.5"
                      Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1" StrokeLineCap="Round"/>
            </Button>
            <Button x:Name="CaptionMaximize" Classes="caption-btn" Click="OnMaximizeClick"
                    Classes.maximized="{Binding IsWindowMaximized}">
                <Panel>
                    <!-- 图标可见性由 VM 的 IsWindowMaximized 驱动（真机经 WindowState 变化回写 VM） -->
                    <Path x:Name="MaximizeIcon" Data="M 1.5 1.5 L 11.5 1.5 L 11.5 11.5 L 1.5 11.5 Z"
                          IsVisible="{Binding !IsWindowMaximized}"
                          Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1" StrokeJoin="Round"/>
                    <Path x:Name="RestoreIcon" IsVisible="{Binding IsWindowMaximized}"
                          Data="M 3.5 3.5 L 11.5 3.5 L 11.5 11.5 L 3.5 11.5 Z M 1.5 6.5 L 1.5 1.5 L 9.5 1.5"
                          Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1" StrokeJoin="Round"/>
                </Panel>
            </Button>
            <Button x:Name="CaptionClose" Classes="caption-btn close" Click="OnCloseClick"
                    ToolTip.Tip="{Binding Loc[window_close]}">
                <Path Data="M 2 2 L 12 12 M 12 2 L 2 12"
                      Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1" StrokeLineCap="Round"/>
            </Button>
        </StackPanel>

        <!-- ==================== 启动遮蔽层：初始化与首个背景预载在遮蔽后进行，就绪/超时后放行 ==================== -->
        <!-- 可见性/淡出由 VM IsBooting 经代码后置驱动（非绑定：淡出需要先动画再收起）；
             Background=Transparent 挡输入（加载期不可操作下层 UI），视觉由 AppBackdrop 的主题渐变承担 -->
        <Panel x:Name="BootSplash" Background="Transparent" IsVisible="False">
            <controls:AppBackdrop GlowMargin="0,46,0,0"/>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20" IsHitTestVisible="False">
                <Border Width="88" Height="88" CornerRadius="22" Background="{DynamicResource AppCardBackground}">
                    <Image Width="52" Height="52" Source="avares://YetAnotherGameLauncher/Assets/app-icon.png"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Spacing="0">
                    <TextBlock Text="YetAnother" FontSize="20" FontWeight="Bold" Opacity="0.85"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Game Launcher" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource AppAccentBrush}" HorizontalAlignment="Center"/>
                </StackPanel>
                <!-- 不定进度条：轨道常驻弱化，高亮滑块由代码后置自泵驱动（Transform 不能 x:Name，运行时挂） -->
                <Grid Width="200" Height="4" HorizontalAlignment="Center">
                    <Border Height="2" VerticalAlignment="Center" CornerRadius="1"
                            Background="{DynamicResource AppTextSecondary}" Opacity="0.2"/>
                    <Border x:Name="SplashPulseBar" Width="48" Height="4" CornerRadius="2"
                            HorizontalAlignment="Left" Background="{DynamicResource AppAccentBrush}"/>
                </Grid>
                <TextBlock Text="{Binding Loc[splash_loading]}" FontSize="13"
                           Foreground="{DynamicResource AppTextSecondary}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Panel>
    </Panel>
</Window>
