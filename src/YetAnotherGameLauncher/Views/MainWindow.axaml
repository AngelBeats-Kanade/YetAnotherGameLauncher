<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:YetAnotherGameLauncher.ViewModels"
        xmlns:models="using:YetAnotherGameLauncher.Core.Models"
        xmlns:controls="using:YetAnotherGameLauncher.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
        x:Class="YetAnotherGameLauncher.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="YetAnotherGameLauncher"
        Icon="avares://YetAnotherGameLauncher/Assets/app-icon.ico"
        Width="1120" Height="720" MinWidth="920" MinHeight="620"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="BorderOnly"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI, Noto Sans CJK SC, Segoe UI, Inter">

    <Window.Resources>
        <!-- 齿轮图标（侧栏设置入口与详情页游戏设置入口共用） -->
        <StreamGeometry x:Key="GearIconGeo">M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z</StreamGeometry>
    </Window.Resources>

    <Window.Styles>
        <!-- 侧栏列表项：圆角、悬停/选中为弱化强调（左内边距给选中指示点留位，图标不贴点） -->
        <Style Selector="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style Selector="ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSidebarHover}"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSidebarSelected}"/>
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSidebarSelected}"/>
        </Style>

        <!-- 状态点：默认灰，已安装绿，有更新强调蓝 -->
        <Style Selector="Ellipse.dot">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="{DynamicResource AppTextSecondary}"/>
        </Style>
        <Style Selector="Ellipse.dot.installed">
            <Setter Property="Fill" Value="{DynamicResource AppStatusOk}"/>
        </Style>
        <Style Selector="Ellipse.dot.has-update">
            <Setter Property="Fill" Value="{DynamicResource AppAccentBrush}"/>
        </Style>

        <!-- 玻璃卡片（浮在窗口背景上） -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource AppCardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style Selector="TextBlock.card-caption">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondary}"/>
        </Style>

        <!-- 表单保存结果提示：绿色成功 / 红色失败（文本空白时由 HasMessage 隐藏） -->
        <Style Selector="TextBlock.save-msg">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource AppStatusOk}"/>
        </Style>
        <Style Selector="TextBlock.save-msg.failed">
            <Setter Property="Foreground" Value="{DynamicResource AppErrorText}"/>
        </Style>

        <!-- 常用按钮规格：小号操作钮与返回钮 -->
        <Style Selector="Button.btn-sm">
            <Setter Property="Padding" Value="18,8"/>
        </Style>
        <Style Selector="Button.back-btn">
            <Setter Property="Padding" Value="20,9"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <!-- 设置卡片上的次级按钮：底色取悬停色与卡片明确区分（曾与卡片同色而"隐形"），描边沿用卡片边框色 -->
        <Style Selector="Button.glass">
            <Setter Property="Background" Value="{DynamicResource AppSidebarHover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.glass /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSidebarHover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
        <Style Selector="Button.glass:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSidebarSelected}"/>
        </Style>

        <!-- 插画上的玻璃按钮：固定暗色半透明底 + 浅色字（详情页暗遮罩方案，两主题一致）。
             前景必须设在模板 presenter 层：Fluent 的 :pointerover/:pressed/:disabled 状态样式
             都在 presenter 上写主题前景（亮色主题为黑/灰），会压过 Button 本体上的浅色字 -->
        <Style Selector="Button.glass-onart">
            <Setter Property="Background" Value="{DynamicResource AppOnArtworkCard}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppOnArtworkBrush}"/>
        </Style>
        <Style Selector="Button.glass-onart /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppOnArtworkCard}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Foreground" Value="{DynamicResource AppOnArtworkBrush}"/>
        </Style>
        <Style Selector="Button.glass-onart:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppOnArtworkCardHover}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppOnArtworkBrush}"/>
        </Style>
        <Style Selector="Button.glass-onart:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppOnArtworkCard}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppOnArtworkBrush}"/>
        </Style>
        <Style Selector="Button.glass-onart:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppOnArtworkCard}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppOnArtworkSecondary}"/>
        </Style>

        <!-- 图标按钮 -->
        <Style Selector="Button.icon-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="9"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.icon-btn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.icon-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSidebarHover}"/>
        </Style>

        <!-- 设置/关于导航项：当前页对应的入口与游戏列表同色高亮 -->
        <Style Selector="Button.nav-item.selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSidebarSelected}"/>
        </Style>

        <!-- 非游戏页时抑制游戏列表的选中高亮（导航高亮让位给设置/关于入口） -->
        <Style Selector="ListBox.nav-inactive ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.nav-inactive ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- 按下微缩 -->
        <Style Selector="Button.pressable">
            <Setter Property="RenderTransform" Value="scale(1)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08"/>
                </Transitions>
            </Setter>
            <Style Selector="^:pressed">
                <Setter Property="RenderTransform" Value="scale(0.97)"/>
            </Style>
        </Style>

        <!-- 侧栏收起态：条目图标居中 -->
        <Style Selector="Border.game-sidebar.collapsed ListBoxItem">
            <Setter Property="Padding" Value="3"/>
        </Style>
        <Style Selector="Border.game-sidebar.collapsed Button.icon-btn">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="9"/>
        </Style>

        <!-- 页面切换：Store 式横滑过渡（前进自右滑入、后退自左滑入，配淡入）；
             详情页根为 Panel 无边距，设置类页根为 Border.page 统一留边 -->

        <!-- 设置类页面（设置/关于/游戏设置）的统一页边距（顶部避开 46px 标题色带） -->
        <Style Selector="Border.page">
            <Setter Property="Margin" Value="34,48,34,24"/>
        </Style>
        <Style Selector="ContentControl.nav-forward :is(Control).page">
            <Style.Animations>
                <Animation Duration="0:0:0.3" FillMode="Forward" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="TranslateTransform.X" Value="56"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="TranslateTransform.X" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="ContentControl.nav-back :is(Control).page">
            <Style.Animations>
                <Animation Duration="0:0:0.3" FillMode="Forward" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="TranslateTransform.X" Value="-56"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="TranslateTransform.X" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- 圆角内容浮卡（游戏插画等全部裁剪在内）；最大化时去圆角与边距 -->
        <!-- 内容容器：透明底——设置类页面直接浮在应用背景（渐变+光晕）上；
             详情页的插画在页面模板内自带背景。仅负责裁剪与（详情态）圆角 -->
        <!-- 页面板（所有页面统一，同详情页海报）：从色带下方开始、左上角 10px 圆角、
             右/下/左贴边全出血（其余角由窗口圆角负责）；内部自带应用背景层，
             设置/关于的半透明卡片浮在它上面，详情页海报照旧覆盖全板 -->
        <Style Selector="Border.content-card">
            <Setter Property="CornerRadius" Value="10,0,0,0"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Margin" Value="0,46,0,0"/>
        </Style>
        <!-- 标题拖拽区：覆盖色带整条（46px），所有页面一致 -->
        <Style Selector="Border.title-drag">
            <Setter Property="Height" Value="46"/>
        </Style>

        <!-- 自绘标题栏按钮：最小化/最大化/关闭（关闭悬停红色，Win11 习惯） -->
        <Style Selector="Button.caption-btn">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.caption-btn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.caption-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppSidebarHover}"/>
        </Style>
        <Style Selector="Button.caption-btn.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E81123"/>
        </Style>
        <Style Selector="Button.caption-btn.close:pointerover">
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Styles>

    <!-- ==================== 窗口级结构：应用自有背景 → 主布局（游戏背景只在详情页模板内） ==================== -->
    <Panel>

        <controls:AppBackdrop GlowMargin="0,46,0,0"/>

        <Grid ColumnDefinitions="Auto,*">

            <!-- ==================== 侧边栏（与标题区同色一体，无分隔线；可缩放 264 ↔ 68） ==================== -->
            <Border Grid.Column="0" Classes="game-sidebar"
                    Width="{Binding SidebarWidth}"
                    Classes.collapsed="{Binding !IsSidebarExpanded}"
                    Background="{DynamicResource AppSidebarBackground}">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Width" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                    </Transitions>
                </Border.Transitions>
                <Panel>
                    <DockPanel Margin="12,16,12,12" LastChildFill="True">

                    <!-- 顶部：展开态 = logo + 标题 + 折叠（logo 区兼任自绘标题栏的拖拽区） -->
                    <StackPanel DockPanel.Dock="Top">
                        <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding IsSidebarExpanded}"
                              PointerPressed="OnTitlePointerPressed" DoubleTapped="OnTitleDoubleTapped">
                            <Image Width="38" Height="38"
                                   Source="avares://YetAnotherGameLauncher/Assets/app-icon.png"/>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="0">
                                <TextBlock Text="YetAnother" FontSize="19" FontWeight="Bold" Opacity="0.85"/>
                                <TextBlock Text="Game Launcher" FontSize="19" FontWeight="Bold"
                                           Foreground="{DynamicResource AppAccentBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="2" Classes="icon-btn pressable" Command="{Binding ToggleSidebarCommand}"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="{Binding Loc[sidebar_expanded_collapse]}">
                                <Path Data="M10.4 6.6 4.9 12l5.5 5.4 1.5-1.4-4.1-4 4.1-4zM16.9 6.6 11.4 12l5.5 5.4 1.5-1.4-4.1-4 4.1-4z"
                                      Fill="{Binding $parent[Button].Foreground}"
                                      Stretch="Uniform" Width="16" Height="16"/>
                            </Button>
                        </Grid>
                        <Button Classes="icon-btn pressable" Command="{Binding ToggleSidebarCommand}"
                                IsVisible="{Binding !IsSidebarExpanded}"
                                HorizontalAlignment="Center"
                                ToolTip.Tip="{Binding Loc[sidebar_collapsed_expand]}">
                            <Path Data="M13.6 6.6 19.1 12l-5.5 5.4-1.5-1.4 4.1-4-4.1-4zM7.1 6.6 12.6 12l-5.5 5.4-1.5-1.4 4.1-4-4.1-4z"
                                  Fill="{Binding $parent[Button].Foreground}"
                                  Stretch="Uniform" Width="18" Height="18"/>
                        </Button>
                    </StackPanel>

                    <!-- 计数与状态提示（收起时隐藏） -->
                    <StackPanel DockPanel.Dock="Top" IsVisible="{Binding IsSidebarExpanded}" Margin="6,12,4,0" Spacing="3">
                        <TextBlock Text="{Binding GameCountText}" FontSize="12"
                                   Foreground="{DynamicResource AppTextSecondary}"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource AppErrorText}" IsVisible="{Binding ConfigError}"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource AppTextSecondary}" IsVisible="{Binding ShowStatusAsHint}"/>
                    </StackPanel>

                    <!-- 底部：设置 / 关于（x:Name 供选中指示点定位） -->
                    <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,10,0,0">
                        <Button x:Name="SettingsNavButton" Classes="icon-btn pressable nav-item" Command="{Binding ShowSettingsCommand}"
                                Classes.selected="{Binding IsSettingsNavActive}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="14,8"
                                ToolTip.Tip="{Binding Loc[common_settings]}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Path Data="{StaticResource GearIconGeo}"
                                      Fill="{Binding $parent[Button].Foreground}"
                                      Stretch="Uniform" Width="18" Height="18"
                                      HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding Loc[common_settings]}"
                                           FontSize="13.5" VerticalAlignment="Center"
                                           IsVisible="{Binding IsSidebarExpanded}"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="AboutNavButton" Classes="icon-btn pressable nav-item" Command="{Binding ShowAboutCommand}"
                                Classes.selected="{Binding IsAboutNavActive}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Padding="14,8"
                                ToolTip.Tip="{Binding Loc[common_about]}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"
                                      Fill="{Binding $parent[Button].Foreground}"
                                      Stretch="Uniform" Width="18" Height="18"
                                      HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding Loc[common_about]}"
                                           FontSize="13.5" VerticalAlignment="Center"
                                           IsVisible="{Binding IsSidebarExpanded}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 游戏列表（非游戏页时高亮让位给设置/关于，选中项经 GameNavSelection 转发） -->
                    <ListBox x:Name="GamesList"
                             ItemsSource="{Binding Games}"
                             SelectedItem="{Binding GameNavSelection}"
                             Classes.nav-inactive="{Binding !IsGameNavActive}"
                             Background="Transparent" BorderThickness="0" Margin="0,14,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:GameItemViewModel">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Width="38" Height="38" CornerRadius="10" ClipToBounds="True"
                                            Background="{DynamicResource AppAccentBrush}">
                                        <Panel>
                                            <Image Source="{Binding GameIcon}" Stretch="UniformToFill"
                                                   IsVisible="{Binding HasGameIcon}"/>
                                            <TextBlock Text="{Binding IconText}" FontSize="17" FontWeight="SemiBold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       IsVisible="{Binding !HasGameIcon}"/>
                                        </Panel>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="1"
                                                IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsSidebarExpanded}">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="14.5"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding StatusText}" FontSize="11.5"
                                                   Foreground="{DynamicResource AppTextSecondary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Ellipse Grid.Column="2" Classes="dot" VerticalAlignment="Center"
                                             IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsSidebarExpanded}"
                                             Classes.installed="{Binding IsInstalled}"
                                             Classes.has-update="{Binding HasUpdate}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    </DockPanel>

            <!-- 侧栏选中指示点：展开态静息于选中项内部左缘（收起态贴侧栏左缘），选中项变更时
                 "朝反方向拉长 → 平移 → 行进侧收缩"（编舞在代码后置，X 由 MoveNavIndicator 直接定位） -->
            <Border x:Name="NavIndicator"
                    Width="5" CornerRadius="2.5"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="{DynamicResource AppAccentBrush}"
                            IsHitTestVisible="False" IsVisible="False"
                            RenderTransformOrigin="0,0"
                            BoxShadow="0 0 8 #592E7CF6">
                        <Border.RenderTransform>
                            <!-- 子顺序即语义：先 Scale 后 Translate（原点 0,0）→ 视觉区间 [TranslateY, TranslateY+Height×ScaleY]；
                                 若反过来写，平移量会被缩放系数压缩（指示点首个版本错位的根因）。
                                 变换不生成 x:Name 字段（AVLN2000），代码后置按声明顺序解析 -->
                            <TransformGroup>
                                <ScaleTransform/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Border.RenderTransform>
                    </Border>
                </Panel>
            </Border>

            <!-- ==================== 主内容列：顶部标题色带（与侧栏同色，自绘标题钮位于其上）+
                 页面板（所有页面统一：色带下方开始、左上角圆角、贴边全出血） ==================== -->
            <Grid Grid.Column="1">
                <!-- 色带高 56 = 46 可见 + 10px 延伸到页面板圆角后方：
                     圆角缺口处露出色带颜色而非更深的底层背景（暗色主题下曾呈"多一层"方角） -->
                <Border x:Name="TitleChrome" Height="56" VerticalAlignment="Top"
                        Background="{DynamicResource AppSidebarBackground}" IsHitTestVisible="False"/>
                <Border x:Name="ContentCard" Classes="content-card">
                    <Panel>
                        <!-- 页面底：应用背景随页面板圆角裁剪，详情页海报照旧覆盖全板 -->
                        <controls:AppBackdrop/>
                        <ContentControl x:Name="PageHost" Content="{Binding CurrentPage}"
                                        Classes.nav-forward="{Binding !IsNavBack}"
                                        Classes.nav-back="{Binding IsNavBack}">
                        <ContentControl.DataTemplates>

                            <!-- ========== 游戏详情页（海报式：游戏当期背景铺满主区域，仅此页） ========== -->
                            <DataTemplate DataType="{x:Type vm:GameItemViewModel}">
                                <!-- ClipToBounds：插画只属于内容卡片，不外溢到侧栏底下 -->
                                <Panel Classes="page" ClipToBounds="True">

                                    <!-- 游戏当期背景：静态海报（加载前占位）→ 视频层（首帧到达后接管）
                                         + 三段式暗遮罩保证文字可读。
                                         左上锚定：UniformToFill 的溢出只裁右侧/底部，海报左缘完整贴住侧栏不被裁切 -->
                                    <Image x:Name="PosterImage" Source="{Binding BackgroundImage}" Stretch="UniformToFill"
                                           HorizontalAlignment="Left" VerticalAlignment="Top"
                                           IsVisible="{Binding HasBackgroundImage}"/>
                                    <controls:FrameSurface Player="{Binding VideoPlayer}"
                                                           IsVisible="{Binding HasBackgroundVideo}"
                                                           HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <!-- 遮罩：盖住海报/视频层，保证 UI 文字在两主题可读 -->
                                    <Border IsVisible="{Binding HasBackgroundImage}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                                <GradientStop Color="{DynamicResource AppBackdropScrimTopColor}" Offset="0"/>
                                                <GradientStop Color="{DynamicResource AppBackdropScrimMidColor}" Offset="0.45"/>
                                                <GradientStop Color="{DynamicResource AppBackdropScrimBottomColor}" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>

                                    <!-- 无插画回退：固定深色渐变底，白字在两主题同样可读 -->
                                    <Border IsVisible="{Binding !HasBackgroundImage}">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                                <GradientStop Color="#232B3A" Offset="0"/>
                                                <GradientStop Color="#0D1017" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>

                                    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto,Auto" Margin="42,36,42,34">

                                        <!-- 标题区（左上） -->
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="18" Margin="14,10,0,0">
                                            <Border Width="76" Height="76" CornerRadius="18" ClipToBounds="True"
                                                    Background="{DynamicResource AppAccentBrush}"
                                                    BoxShadow="0 8 24 #40000000">
                                                <Panel>
                                                    <Image Source="{Binding GameIcon}" Stretch="UniformToFill"
                                                           IsVisible="{Binding HasGameIcon}"/>
                                                    <TextBlock Text="{Binding IconText}" FontSize="34" FontWeight="SemiBold"
                                                               Foreground="White"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               IsVisible="{Binding !HasGameIcon}"/>
                                                </Panel>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center" Spacing="10">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="32" FontWeight="Bold"
                                                       Foreground="{DynamicResource AppOnArtworkBrush}"/>
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{Binding Loc[game_server]}" FontSize="12.5"
                                                               Foreground="{DynamicResource AppOnArtworkSecondary}"
                                                               VerticalAlignment="Center"/>
                                                    <ComboBox ItemsSource="{Binding Servers}"
                                                              SelectedItem="{Binding SelectedServer}"
                                                              MinWidth="200">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="models:GameServer">
                                                                <TextBlock Text="{Binding Name}"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 状态区（无卡片，直接在背景上） -->
                                        <StackPanel Grid.Row="1" Spacing="5" Margin="18,26,0,0" VerticalAlignment="Top"
                                                    HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Ellipse Classes="dot" Width="12" Height="12"
                                                         Classes.installed="{Binding IsInstalled}"
                                                         Classes.has-update="{Binding HasUpdate}"/>
                                                <TextBlock Text="{Binding StatusText}" FontSize="19" FontWeight="SemiBold"
                                                         Foreground="{DynamicResource AppOnArtworkBrush}"/>
                                                <Border Padding="10,3" CornerRadius="7" VerticalAlignment="Center"
                                                        Background="{DynamicResource AppPredownloadBadge}"
                                                        IsVisible="{Binding HasStagedPredownload}">
                                                    <TextBlock Text="{Binding Loc[game_stagedBadge]}" FontSize="12" Foreground="White"/>
                                                </Border>
                                            </StackPanel>
                                            <!-- 版本号贴片：自带对比底面，压在背景插画上仍清晰可读 -->
                                            <Border HorizontalAlignment="Left" Margin="22,0,0,0"
                                                    Padding="9,3" CornerRadius="7"
                                                    Background="{DynamicResource AppVersionChipBackground}">
                                                <TextBlock Text="{Binding VersionText}" FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AppVersionChipText}"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- 主操作行（底部，右对齐，对标官方启动器的"进入游戏"） -->
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12"
                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                    Margin="0,0,4,10">
                                            <Button Command="{Binding PredownloadCommand}"
                                                    IsVisible="{Binding PredownloadAvailable}"
                                                    Content="{Binding Loc[game_predownload]}"
                                                    Classes="pressable glass-onart"
                                                    Padding="20,11" VerticalAlignment="Center"/>
                                            <Button Command="{Binding ApplyPredownloadCommand}"
                                                    IsVisible="{Binding HasStagedPredownload}"
                                                    Content="{Binding Loc[game_applyPredownload]}"
                                                    Classes="pressable glass-onart"
                                                    Padding="20,11" VerticalAlignment="Center"/>
                                            <!-- 安装/更新/校验与启动、预下载同为海报操作按钮：常驻玻璃样式
                                                 （此前按安装状态切换类，未安装时回退 Fluent 默认在海报上不可读） -->
                                            <Button Classes="pressable glass-onart"
                                                    Command="{Binding InstallOrUpdateCommand}"
                                                    Content="{Binding InstallButtonText}"
                                                    FontSize="15"
                                                    Padding="28,11" VerticalAlignment="Center"/>
                                            <Button Classes="pressable" Command="{Binding LaunchCommand}"
                                                    IsEnabled="{Binding CanLaunch}"
                                                    Classes.glass-onart="{Binding !IsInstalled}"
                                                    Content="{Binding Loc[game_launch]}"
                                                    FontSize="17" FontWeight="SemiBold"
                                                    Padding="46,13"/>
                                            <Button Classes="icon-btn pressable" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowGameSettingsCommand}"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource AppOnArtworkBrush}"
                                                    ToolTip.Tip="{Binding Loc[game_settings_title]}">
                                                <Path Data="{StaticResource GearIconGeo}"
                                                      Fill="{Binding $parent[Button].Foreground}"
                                                      Stretch="Uniform" Width="19" Height="19"/>
                                            </Button>
                                        </StackPanel>

                                        <!-- 进度（busy 时，横贯） -->
                                        <Border Grid.Row="3" Classes="card" Padding="16,12"
                                                IsVisible="{Binding IsBusy}" Margin="0,0,0,8">
                                            <StackPanel Spacing="7">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="{Binding ProgressText}" FontSize="12.5"
                                                               Foreground="{DynamicResource AppTextSecondary}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ProgressPercent, StringFormat={}{0:0}%}"
                                                               FontSize="12.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AppOnArtworkBrush}"/>
                                                </Grid>
                                                <ProgressBar Maximum="100" Value="{Binding ProgressPercent}" Height="6"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- 页脚（渠道 · 服务器 · 安装目录；路径列自适应收窄并省略） -->
                                        <Grid Grid.Row="4" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" Opacity="0.75"
                                              HorizontalAlignment="Stretch" Margin="18,2,0,0">
                                            <TextBlock Grid.Column="0" Text="{Binding Loc[game_info_channel]}" FontSize="11.5"
                                                       Foreground="{DynamicResource AppOnArtworkSecondary}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ChannelDisplayName}" FontSize="11.5" Margin="6,0,0,0"
                                                       Foreground="{DynamicResource AppOnArtworkSecondary}"/>
                                            <TextBlock Grid.Column="2" Text="·" FontSize="11.5" Margin="8,0"
                                                       Foreground="{DynamicResource AppOnArtworkSecondary}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Loc[game_server]}" FontSize="11.5"
                                                       Foreground="{DynamicResource AppOnArtworkSecondary}"/>
                                            <TextBlock Grid.Column="4" Text="{Binding ServerCountText}" FontSize="11.5" Margin="6,0,0,0"
                                                       Foreground="{DynamicResource AppOnArtworkSecondary}"/>
                                            <TextBlock Grid.Column="5" Text="·" FontSize="11.5" Margin="8,0"
                                                       Foreground="{DynamicResource AppOnArtworkSecondary}"/>
                                            <TextBlock Grid.Column="6" Text="{Binding Loc[game_info_installDir]}" FontSize="11.5"
                                                       Foreground="{DynamicResource AppOnArtworkSecondary}"/>
                                            <TextBlock Grid.Column="7" Text="{Binding InstallDirPath}" FontSize="11.5" Margin="6,0,0,0"
                                                       Foreground="{DynamicResource AppOnArtworkSecondary}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding InstallDirPath}"/>
                                        </Grid>
                                    </Grid>
                                </Panel>
                            </DataTemplate>

                            <!-- ========== 设置页 ========== -->
                            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                                <Border Classes="page">
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel MaxWidth="720" HorizontalAlignment="Stretch" Spacing="18">

                                            <TextBlock Text="{Binding Loc[settings_title]}" FontSize="28" FontWeight="Bold" Margin="0,4,0,4"/>

                                            <!-- 外观 -->
                                            <Border Classes="card">
                                                <StackPanel Spacing="10">
                                                    <TextBlock Text="{Binding Loc[settings_appearance]}" FontSize="15" FontWeight="SemiBold"/>
                                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="24">
                                                        <StackPanel Grid.Column="0" Spacing="6">
                                                            <TextBlock Text="{Binding Loc[settings_theme]}" Classes="card-caption"/>
                                                            <ComboBox ItemsSource="{Binding ThemeModes}"
                                                                      SelectedItem="{Binding SelectedTheme}"
                                                                      HorizontalAlignment="Stretch">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:ThemeOption">
                                                                        <TextBlock Text="{Binding DisplayName}"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Spacing="6">
                                                            <TextBlock Text="{Binding Loc[settings_language]}" Classes="card-caption"/>
                                                            <ComboBox ItemsSource="{Binding Languages}"
                                                                      SelectedItem="{Binding SelectedLanguage}"
                                                                      HorizontalAlignment="Stretch">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:LanguageOption">
                                                                        <TextBlock Text="{Binding DisplayName}"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Loc[settings_appearanceHint]}" Classes="card-caption"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- 应用背景（设置/关于/侧栏底色；游戏详情页背景不受影响） -->
                                            <Border Classes="card">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="{Binding Loc[settings_appBackground]}" FontSize="15" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Loc[settings_appBackground_hint]}" Classes="card-caption" TextWrapping="Wrap"/>
                                                    <TextBox Text="{Binding AppBackgroundPath}" IsReadOnly="True"
                                                             PlaceholderText="{Binding Loc[settings_appBackground_watermark]}"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                                        <Button Content="{Binding Loc[settings_appBackground_browse]}"
                                                                Command="{Binding BrowseAppBackgroundCommand}"
                                                                Classes="pressable btn-sm"/>
                                                        <Button Content="{Binding Loc[settings_appBackground_reset]}"
                                                                Command="{Binding ResetAppBackgroundCommand}"
                                                                Classes="glass pressable btn-sm"/>
                                                        <TextBlock Classes="save-msg" VerticalAlignment="Center"
                                                                   Text="{Binding AppBackgroundSave.Message}"
                                                                   IsVisible="{Binding AppBackgroundSave.HasMessage}"
                                                                   Classes.failed="{Binding AppBackgroundSave.Failed}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- 下载：安装根目录（可编辑） -->
                                            <Border Classes="card">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="{Binding Loc[settings_downloads]}" FontSize="15" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Loc[settings_installRoot]}" Classes="card-caption"/>
                                                    <TextBox x:Name="InstallRootBox" Text="{Binding InstallRootDraft}"/>
                                                    <TextBlock Text="{Binding Loc[settings_installRootEdit]}" Classes="card-caption"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                                        <Button Content="{Binding Loc[settings_installRootBrowse]}"
                                                                Command="{Binding BrowseInstallRootCommand}"
                                                                Classes="pressable btn-sm"/>
                                                        <TextBlock Classes="save-msg" VerticalAlignment="Center"
                                                                   Text="{Binding InstallRootSave.Message}"
                                                                   IsVisible="{Binding InstallRootSave.HasMessage}"
                                                                   Classes.failed="{Binding InstallRootSave.Failed}"/>
                                                    </StackPanel>
                                                    <StackPanel Spacing="4" Margin="0,8,0,0">
                                                        <TextBlock Text="{Binding Loc[settings_downloadLimit]}" Classes="card-caption"/>
                                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                                            <TextBox Text="{Binding SpeedLimitMbDraft}" Width="140"/>
                                                            <TextBlock Text="{Binding Loc[settings_downloadLimitHint]}" Classes="card-caption"
                                                                       VerticalAlignment="Center"/>
                                                            <Button Content="{Binding Loc[common_save]}"
                                                                    Command="{Binding SaveDownloadLimitCommand}"
                                                                    Classes="glass pressable btn-sm"/>
                                                            <TextBlock Classes="save-msg" VerticalAlignment="Center"
                                                                       Text="{Binding SpeedLimitSave.Message}"
                                                                       IsVisible="{Binding SpeedLimitSave.HasMessage}"
                                                                       Classes.failed="{Binding SpeedLimitSave.Failed}"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <ToggleSwitch Content="{Binding Loc[settings_autostart]}"
                                                                  IsChecked="{Binding IsAutostart, Mode=OneWay}"
                                                                  Command="{Binding ToggleAutostartCommand}" Margin="0,6,0,0"/>
                                                    <TextBlock Classes="save-msg"
                                                               Text="{Binding AutostartSave.Message}"
                                                               IsVisible="{Binding AutostartSave.HasMessage}"
                                                               Classes.failed="{Binding AutostartSave.Failed}"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- 配置文件 -->
                                            <Border Classes="card">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="{Binding Loc[settings_configFile]}" FontSize="15" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding ConfigFilePath}" FontSize="12.5"
                                                               Foreground="{DynamicResource AppTextSecondary}"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Loc[settings_configFileHint]}" Classes="card-caption"/>
                                                    <Button Content="{Binding Loc[settings_openConfigDir]}" Command="{Binding OpenConfigFolderCommand}"
                                                            HorizontalAlignment="Left" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>

                                            <Button Content="{Binding Loc[common_backToGames]}" Command="{Binding ShowGamesCommand}"
                                                    Classes="pressable back-btn"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </DataTemplate>

                            <!-- ========== 关于页 ========== -->
                            <DataTemplate DataType="{x:Type vm:AboutViewModel}">
                                <Border Classes="page">
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel MaxWidth="720" HorizontalAlignment="Stretch" Spacing="18">

                                            <TextBlock Text="{Binding Loc[about_title]}" FontSize="28" FontWeight="Bold" Margin="0,4,0,4"/>

                                            <Border Classes="card">
                                                <StackPanel Orientation="Horizontal" Spacing="18">
                                                    <Image Width="60" Height="60"
                                                           Source="avares://YetAnotherGameLauncher/Assets/app-icon.png"/>
                                                    <StackPanel VerticalAlignment="Center" Spacing="4">
                                                        <TextBlock Text="YetAnotherGameLauncher" FontSize="20" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Loc[about_description]}" FontSize="12.5"
                                                                   Foreground="{DynamicResource AppTextSecondary}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <Border Classes="card">
                                                <StackPanel Spacing="8">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                                        <TextBlock Grid.Column="0" Text="{Binding Loc[about_version]}" Classes="card-caption" Width="90"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding AppVersion}" FontSize="13.5"/>
                                                    </Grid>
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                                        <TextBlock Grid.Column="0" Text="{Binding Loc[about_runtime]}" Classes="card-caption" Width="90"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding RuntimeVersion}" FontSize="13.5"/>
                                                    </Grid>
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                                        <TextBlock Grid.Column="0" Text="{Binding Loc[about_configFile]}" Classes="card-caption" Width="90"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding ConfigFilePath}" FontSize="13.5"
                                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ConfigFilePath}"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <Border Classes="card">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="{Binding Loc[about_thirdParty]}" FontSize="15" FontWeight="SemiBold"/>
                                                    <ItemsControl ItemsSource="{Binding ThirdParty}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                                                                    <TextBlock Text="{Binding Name}" FontSize="13"/>
                                                                    <TextBlock Grid.Column="1" Text="{Binding License}" Classes="card-caption"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>

                                            <Button Content="{Binding Loc[common_backToGames]}" Command="{Binding ShowGamesCommand}"
                                                    Classes="pressable back-btn"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </DataTemplate>

                            <!-- ========== 游戏设置页（Motrix 式分区） ========== -->
                            <DataTemplate DataType="{x:Type vm:GameSettingsViewModel}">
                                <Border Classes="page">
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel MaxWidth="720" HorizontalAlignment="Stretch" Spacing="18">

                                            <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,4,0,4">
                                                <TextBlock Text="{Binding Loc[game_settings_title]}" FontSize="28" FontWeight="Bold"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Game.DisplayName}" FontSize="18"
                                                           Foreground="{DynamicResource AppTextSecondary}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- 位置 -->
                                            <Border Classes="card">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="{Binding Loc[settings_section_location]}" FontSize="15" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Loc[launch_installDir]}" Classes="card-caption"/>
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                        <TextBox Grid.Column="0" x:Name="InstallDirBox" Text="{Binding LaunchSettings.InstallDirDraft}"/>
                                                        <Button Grid.Column="1" Content="{Binding Loc[launch_installDirBrowse]}"
                                                                Command="{Binding LaunchSettings.BrowseInstallDirCommand}"
                                                                Classes="pressable btn-sm"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Loc[launch_installDirHint]}" Classes="card-caption"/>
                                                    <TextBlock Classes="save-msg"
                                                               Text="{Binding LaunchSettings.Save.Message}"
                                                               IsVisible="{Binding LaunchSettings.Save.HasMessage}"
                                                               Classes.failed="{Binding LaunchSettings.Save.Failed}"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- 启动 -->
                                            <Border Classes="card">
                                                <StackPanel Spacing="12">
                                                    <TextBlock Text="{Binding Loc[settings_section_launch]}" FontSize="15" FontWeight="SemiBold"/>

                                                    <StackPanel Spacing="4" IsVisible="{Binding LaunchSettings.IsLinux}">
                                                        <TextBlock Text="{Binding Loc[launch_compat]}" Classes="card-caption"/>
                                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                                            <ComboBox ItemsSource="{Binding LaunchSettings.LaunchModes}"
                                                                      SelectedItem="{Binding LaunchSettings.SelectedLaunchMode}"
                                                                      MinWidth="220">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:LaunchModeOption">
                                                                        <TextBlock Text="{Binding Name}"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                            <ComboBox ItemsSource="{Binding LaunchSettings.ProtonVersions}"
                                                                      SelectedItem="{Binding LaunchSettings.SelectedProtonVersion}"
                                                                      MinWidth="200"
                                                                      IsVisible="{Binding LaunchSettings.IsProtonMode}">
                                                            </ComboBox>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Loc[launch_windowsDefaultHint]}"
                                                               Classes="card-caption"
                                                               IsVisible="{Binding !LaunchSettings.IsLinux}"/>

                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="{Binding Loc[launch_commandTemplate]}" Classes="card-caption"/>
                                                        <TextBox Text="{Binding LaunchSettings.CommandTemplate}"
                                                                 PlaceholderText="{}{exe} / {installDir}"/>
                                                        <TextBlock Text="{Binding Loc[launch_commandTemplateHint]}" Classes="card-caption"/>
                                                    </StackPanel>
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="{Binding Loc[launch_workingDirectory]}" Classes="card-caption"/>
                                                        <TextBox Text="{Binding LaunchSettings.WorkingDirectory}"/>
                                                        <TextBlock Text="{Binding Loc[launch_workingDirectoryHint]}" Classes="card-caption"/>
                                                    </StackPanel>
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="{Binding Loc[launch_environment]}" Classes="card-caption"/>
                                                        <TextBox Text="{Binding LaunchSettings.EnvironmentText}"
                                                                 AcceptsReturn="True" MinHeight="80" TextWrapping="NoWrap"
                                                                 FontFamily="Consolas, Cascadia Mono, monospace"/>
                                                        <TextBlock Text="{Binding Loc[launch_environmentHint]}" Classes="card-caption"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- 游戏信息 -->
                                            <Border Classes="card">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="{Binding Loc[settings_section_info]}" FontSize="15" FontWeight="SemiBold"/>
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                                        <TextBlock Grid.Column="0" Text="{Binding Loc[game_info_channel]}" Classes="card-caption" Width="110"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Game.ChannelDisplayName}" FontSize="13.5"/>
                                                    </Grid>
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                                        <TextBlock Grid.Column="0" Text="{Binding Loc[game_info_server]}" Classes="card-caption" Width="110"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Game.SelectedServer.Name}" FontSize="13.5"/>
                                                    </Grid>
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                                        <TextBlock Grid.Column="0" Text="{Binding Loc[game_info_installDir]}" Classes="card-caption" Width="110"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Game.InstallDirPath}" FontSize="13.5"
                                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Game.InstallDirPath}"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <Button Content="{Binding Loc[common_backToGames]}" Command="{Binding BackToGameCommand}"
                                                    Classes="pressable back-btn"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </DataTemplate>

                        </ContentControl.DataTemplates>
                    </ContentControl>
                    </Panel>
                </Border>
                <!-- 自绘标题栏拖拽区：覆盖色带整条 46px（按钮在下层无交互内容；侧栏 logo 区拖拽挂在 logo 网格上） -->
                <Border x:Name="TitleDrag" Classes="title-drag" VerticalAlignment="Top" Background="Transparent"
                        PointerPressed="OnTitlePointerPressed" DoubleTapped="OnTitleDoubleTapped"/>
            </Grid>
        </Grid>

        <!-- 自绘标题栏：右上三钮（覆盖在内容卡片之上；图标随最大化/还原切换） -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,8,0">
            <Button x:Name="CaptionMinimize" Classes="caption-btn" Click="OnMinimizeClick"
                    ToolTip.Tip="{Binding Loc[window_minimize]}">
                <Path Data="M 1 5.5 L 11 5.5"
                      Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1" StrokeLineCap="Round"/>
            </Button>
            <Button x:Name="CaptionMaximize" Classes="caption-btn" Click="OnMaximizeClick"
                    ToolTip.Tip="{Binding Loc[window_maximize]}">
                <Panel>
                    <Path x:Name="MaximizeIcon" Data="M 1.5 1.5 L 11.5 1.5 L 11.5 11.5 L 1.5 11.5 Z"
                          Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1" StrokeJoin="Round"/>
                    <Path x:Name="RestoreIcon" IsVisible="False"
                          Data="M 3.5 3.5 L 11.5 3.5 L 11.5 11.5 L 3.5 11.5 Z M 1.5 6.5 L 1.5 1.5 L 9.5 1.5"
                          Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1" StrokeJoin="Round"/>
                </Panel>
            </Button>
            <Button x:Name="CaptionClose" Classes="caption-btn close" Click="OnCloseClick"
                    ToolTip.Tip="{Binding Loc[window_close]}">
                <Path Data="M 2 2 L 12 12 M 12 2 L 2 12"
                      Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1" StrokeLineCap="Round"/>
            </Button>
        </StackPanel>
    </Panel>
</Window>
