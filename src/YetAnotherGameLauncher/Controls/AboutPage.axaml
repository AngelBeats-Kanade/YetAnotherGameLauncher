<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YetAnotherGameLauncher.ViewModels"
             x:Class="YetAnotherGameLauncher.Controls.AboutPage"
             x:DataType="vm:AboutViewModel">
    <!-- 关于页：应用信息、版本与第三方声明。原 MainWindow.axaml 内联 DataTemplate 提取，
         绑定契约不变（DataContext = AboutViewModel，页面切换动画经 .page 类继续命中） -->
    <Border Classes="page">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="720" HorizontalAlignment="Stretch" Spacing="16">

                <TextBlock Text="{Binding Loc[about_title]}" FontSize="28" FontWeight="Bold" Margin="0,4,0,4"/>

                <Border Classes="card">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Image Width="60" Height="60"
                               Source="avares://YetAnotherGameLauncher/Assets/app-icon.png"/>
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="YetAnotherGameLauncher" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Loc[about_description]}" FontSize="13"
                                       Foreground="{DynamicResource AppTextSecondary}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <!-- 标签列 110px：与游戏设置页信息卡同规格（评审 P2-10，原 90px 三处各自为政） -->
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                            <TextBlock Grid.Column="0" Text="{Binding Loc[about_version]}" Classes="card-caption" Width="110"/>
                            <TextBlock Grid.Column="1" Text="{Binding AppVersion}" FontSize="13"/>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                            <TextBlock Grid.Column="0" Text="{Binding Loc[about_runtime]}" Classes="card-caption" Width="110"/>
                            <TextBlock Grid.Column="1" Text="{Binding RuntimeVersion}" FontSize="13"/>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                            <TextBlock Grid.Column="0" Text="{Binding Loc[about_configFile]}" Classes="card-caption" Width="110"/>
                            <TextBlock Grid.Column="1" Text="{Binding ConfigFilePath}" FontSize="13"
                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ConfigFilePath}"/>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                            <TextBlock Grid.Column="0" Text="{Binding Loc[about_projectHome]}" Classes="card-caption" Width="110"/>
                            <!-- 幽灵式图标按钮（GitHub 官方 mark 16px，复用 icon-btn 幽灵底）：
                                 信息卡纯文本行内不放带底描边胶囊（唯一带底控件即"突兀"根源），
                                 图标视觉重量≈13px 信息行文字；完整地址悬停可见 -->
                            <Button Grid.Column="1" Classes="icon-btn ghost-home" HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Command="{Binding OpenProjectHomeCommand}"
                                    ToolTip.Tip="{x:Static vm:AboutViewModel.ProjectHomeUrl}">
                                <Path Data="{StaticResource GitHubIconGeo}"
                                      Fill="{Binding $parent[Button].Foreground}"
                                      Stretch="Uniform" Width="16" Height="16"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding Loc[about_thirdParty]}" FontSize="15" FontWeight="SemiBold"/>
                        <ItemsControl ItemsSource="{Binding ThirdParty}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                        <TextBlock Text="{Binding Name}" FontSize="13"/>
                                        <TextBlock Grid.Column="1" Text="{Binding License}" Classes="card-caption"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Button Content="{Binding Loc[common_backToGames]}" Command="{Binding ShowGamesCommand}"
                        Classes="pressable back-btn"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
