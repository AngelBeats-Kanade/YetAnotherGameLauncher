<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YetAnotherGameLauncher.ViewModels"
             x:Class="YetAnotherGameLauncher.Controls.GachaPage"
             x:DataType="vm:GachaViewModel">
    <!-- 唤取记录页（鸣潮专属）：拉取/筛选 + 统计卡 + 记录列表。原 MainWindow.axaml 内联
         DataTemplate 提取，绑定契约不变（DataContext = GachaViewModel，.page 类继续命中切换动画） -->
    <Border Classes="page">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="760" HorizontalAlignment="Stretch" Spacing="16">

                <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,4,0,4">
                    <TextBlock Text="{Binding Loc[gacha_title]}" FontSize="28" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DisplayName}" FontSize="18"
                               Foreground="{DynamicResource AppTextSecondary}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 拉取与筛选 -->
                <Border Classes="card" Padding="16,12">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Text="{Binding StatusText}" FontSize="12.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource AppTextSecondary}"
                                   VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" MinWidth="170" Margin="0,0,8,0"
                                  ItemsSource="{Binding Pools}"
                                  SelectedItem="{Binding SelectedPool}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:GachaPoolOption">
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="2" Classes="pressable glass-onart"
                                Command="{Binding RefreshCommand}"
                                Content="{Binding Loc[gacha_refresh]}"
                                Padding="18,8" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 统计卡行 -->
                <Grid ColumnDefinitions="*,*,*,*" Margin="0,2,0,2">
                    <Border Classes="card" Margin="0,0,8,0" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc[gacha_stat_total]}" FontSize="12"
                                       Foreground="{DynamicResource AppTextSecondary}"/>
                            <TextBlock Text="{Binding TotalCount}" FontSize="24" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="card" Margin="0,0,8,0" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc[gacha_stat_fiveStar]}" FontSize="12"
                                       Foreground="{DynamicResource AppTextSecondary}"/>
                            <TextBlock Text="{Binding FiveStarCount}" FontSize="24" FontWeight="Bold"
                                       Foreground="Goldenrod"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="card" Margin="0,0,8,0" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc[gacha_stat_fourStar]}" FontSize="12"
                                       Foreground="{DynamicResource AppTextSecondary}"/>
                            <TextBlock Text="{Binding FourStarCount}" FontSize="24" FontWeight="Bold"
                                       Foreground="MediumPurple"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Classes="card" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="{Binding Loc[gacha_stat_sinceFiveStar]}" FontSize="12"
                                       Foreground="{DynamicResource AppTextSecondary}"/>
                            <TextBlock Text="{Binding SinceLastFiveStar}" FontSize="24" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 记录列表（稀有度着色由样式 gacha-rare5/gacha-rare4 承担） -->
                <Border Classes="card" Padding="6,4">
                    <ItemsControl ItemsSource="{Binding Records}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GachaRecordView">
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="10,7">
                                    <TextBlock Text="{Binding QualityLevel}" Width="28" FontWeight="Bold"
                                               Classes.gacha-rare5="{Binding Rare5}"
                                               Classes.gacha-rare4="{Binding Rare4}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Time}"
                                               Foreground="{DynamicResource AppTextSecondary}" FontSize="12"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <Button Content="{Binding Loc[common_backToGames]}" Command="{Binding ShowGameCommand}"
                        Classes="pressable back-btn"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
