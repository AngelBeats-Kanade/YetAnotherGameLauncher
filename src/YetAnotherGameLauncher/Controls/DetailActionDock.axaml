<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YetAnotherGameLauncher.ViewModels"
             x:Class="YetAnotherGameLauncher.Controls.DetailActionDock"
             x:DataType="vm:GameItemViewModel">
    <!-- 详情页底部操作坞（通栏玻璃条）：左列渠道/目录信息（busy 时变进度条），
         右列按钮按"图标 → 次级 → 主 CTA 最右"排布——原按钮行/进度卡/页脚三行合并于此。
         从 MainWindow.axaml 内联提取；宿主处挂 Grid.Row="1"。跨窗口命令经 $parent[Window] 取主 VM -->
    <!-- 方案 A：dock 通栏贴边（左右 16 / 距底 14 由宿主 Grid Margin 提供），自身只留顶部呼吸间距 -->
    <Border Classes="action-dock" Margin="0,12,0,0">
        <Grid ColumnDefinitions="*,Auto">
            <!-- ClipToBounds：英文等宽文案下信息列被按钮列挤压时，溢出绘制会叠到按钮上（judge 07 号截图实锤） -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4"
                        IsVisible="{Binding !IsBusy}" Margin="0,0,24,0"
                        ClipToBounds="True">
                <!-- 信息行与设置页"游戏信息卡"同构：标签弱化 caption、数值 13px 主前景。
                     服务器数量此前挂在行尾且与截断的渠道名脱节（位置/层级都不立），独立成行。
                     行距 22 = 13px 值列 × 1.7 倍行高（≥1.4 可读线） -->
                <!-- 值列必须显式插画上前景：坞底恒为深色玻璃，继承主题前景会在亮色主题变黑字（judge 02 实锤） -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16"
                      RowDefinitions="Auto,Auto,Auto" RowSpacing="0">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Loc[game_info_channel]}"
                               Classes="dock-caption" LineHeight="22" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ChannelDisplayName}"
                               FontSize="13" LineHeight="22" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Foreground="{DynamicResource AppOnArtworkBrush}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Loc[game_server]}"
                               Classes="dock-caption" LineHeight="22" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ServerCountText}"
                               FontSize="13" LineHeight="22" VerticalAlignment="Center"
                               Foreground="{DynamicResource AppOnArtworkBrush}"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding Loc[game_info_installDir]}"
                               Classes="dock-caption" LineHeight="22" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding InstallDirPath}"
                               FontSize="13" LineHeight="22" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding InstallDirPath}" VerticalAlignment="Center"
                               Foreground="{DynamicResource AppOnArtworkBrush}"/>
                </Grid>
            </StackPanel>
            <!-- busy 时信息列让位给进度（不再弹独立进度卡，页面不跳动） -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="8"
                        IsVisible="{Binding IsBusy}" Margin="0,0,24,0">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding ProgressText}" FontSize="13"
                               Foreground="{DynamicResource AppOnArtworkSecondary}"/>
                    <TextBlock Grid.Column="1" Text="{Binding ProgressPercent, StringFormat={}{0:0}%}"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource AppOnArtworkBrush}"/>
                </Grid>
                <ProgressBar Maximum="100" Value="{Binding ProgressPercent}" Height="6"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <!-- 鸣潮专属：唤取记录入口（游戏文件在本地即可用），玻璃胶囊图标钮 -->
                <Button Classes="gacha-onart pressable"
                        IsVisible="{Binding HasGachaEntry}"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowGachaCommand}"
                        CommandParameter="{Binding}"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource AppOnArtworkBrush}"
                        ToolTip.Tip="{Binding Loc[gacha_entry]}">
                    <Path Data="{StaticResource GachaIconGeo}"
                          Fill="{Binding $parent[Button].Foreground}"
                          Stretch="Uniform" Width="19" Height="19"/>
                </Button>
                <Button Classes="icon-btn pressable" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowGameSettingsCommand}"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource AppOnArtworkBrush}"
                        ToolTip.Tip="{Binding Loc[game_settings_title]}">
                    <Path Data="{StaticResource GearIconGeo}"
                          Fill="{Binding $parent[Button].Foreground}"
                          Stretch="Uniform" Width="19" Height="19"/>
                </Button>
                <!-- 主次分明：什么都没有时"安装"是主操作（accent）；
                     检测到游戏/已安装时"启动"升级为主操作，安装/校验钮变次操作 -->
                <Button Classes="pressable"
                        Classes.glass-onart="{Binding InstallIsSecondary}"
                        Classes.accent-onart="{Binding InstallIsPrimary}"
                        Command="{Binding InstallOrUpdateCommand}"
                        Content="{Binding InstallButtonText}"
                        FontSize="15"
                        Padding="28,12" VerticalAlignment="Center"/>
                <Button Command="{Binding PredownloadCommand}"
                        IsVisible="{Binding PredownloadAvailable}"
                        Content="{Binding Loc[game_predownload]}"
                        Classes="pressable predownload-onart"
                        Padding="20,12" VerticalAlignment="Center"/>
                <Button Command="{Binding ApplyPredownloadCommand}"
                        IsVisible="{Binding HasStagedPredownload}"
                        Content="{Binding Loc[game_applyPredownload]}"
                        Classes="pressable glass-onart"
                        Padding="20,12" VerticalAlignment="Center"/>
                <!-- 未安装时隐藏（评审 P1-2：禁用钮常驻改隐藏，安装钮已是主 CTA）；busy 安装中同步隐藏 -->
                <Button Classes="pressable" Command="{Binding LaunchCommand}"
                        IsVisible="{Binding CanLaunch}"
                        Classes.glass-onart="{Binding !CanLaunch}"
                        Classes.accent-onart="{Binding CanLaunch}"
                        Padding="32,12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path Data="{StaticResource PlayIconGeo}"
                              Fill="{Binding $parent[Button].Foreground}"
                              Stretch="Uniform" Width="14"/>
                        <TextBlock Text="{Binding Loc[game_launch]}" FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
