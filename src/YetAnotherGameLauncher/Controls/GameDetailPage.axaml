<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YetAnotherGameLauncher.ViewModels"
             xmlns:controls="using:YetAnotherGameLauncher.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="YetAnotherGameLauncher.Controls.GameDetailPage"
             x:DataType="vm:GameItemViewModel">
    <!-- 游戏详情页（海报式：游戏当期背景铺满主区域，仅此页）。自 MainWindow.axaml 内联模板提取
         （2026-09-29，与其余 4 页的"一行引用"形态对齐）；结构/常数/样式的单一事实源在
         docs/UI_STRUCTURE.md §3。本控件内具名元素只有视觉树搜索可见（namescope 约束见 §1） -->
    <!-- ClipToBounds：插画只属于内容卡片，不外溢到侧栏底下 -->
    <Panel Classes="page" ClipToBounds="True">

        <!-- 游戏当期背景：静态海报（加载前占位）→ 视频层（首帧到达后接管），无遮罩完整呈现。
             左上锚定：UniformToFill 的溢出只裁右侧/底部，海报左缘完整贴住侧栏不被裁切 -->
        <Image x:Name="PosterImage" Source="{Binding BackgroundImage}" Stretch="UniformToFill"
               HorizontalAlignment="Left" VerticalAlignment="Top"
               IsVisible="{Binding HasBackgroundImage}"/>
        <!-- FrameSurface 必须保持默认 Stretch 铺满 Panel——裸控件设 Left/Top
             对齐会测量出 0×0，Render 永远画不出（曾致视频不显示） -->
        <controls:FrameSurface Player="{Binding VideoPlayer}"
                               IsVisible="{Binding HasBackgroundVideo}"/>

        <!-- 无插画回退：固定深色渐变底 + 官方图标水印。
             空态设计（desktop-ui-design §5）：官方未投放背景/缓存缺失时，
             详情页仍是"这个游戏"的页面而非黑屏；图标缺失时优雅降级为纯渐变。
             可见性必须同时看「无海报」「无视频」：本层在 z 序上位于视频层之上，
             只看海报会让"海报缺失但视频在播"被整面不透明渐变盖住（2026-09-25 修复） -->
        <Grid x:Name="ArtworkFallback">
            <Grid.IsVisible>
                <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                    <Binding Path="!HasBackgroundImage"/>
                    <Binding Path="!HasBackgroundVideo"/>
                </MultiBinding>
            </Grid.IsVisible>
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#232B3A" Offset="0"/>
                        <GradientStop Color="#0D1017" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Image Source="{Binding GameIcon}" IsVisible="{Binding HasGameIcon}"
                   Stretch="Uniform" MaxWidth="380" MaxHeight="380"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Margin="0,0,56,72" Opacity="0.13"/>
        </Grid>

        <!-- 顶部渐变纱带（方案 A .ch）：chips 的可读底，全出血、不拦交互。
             固定 140：chips 行位置不随窗口缩放（顶部固定边距簇），
             固定高恰好覆盖；2026-09-25 曾为压官方烧录 Logo 加深加高，
             随自绘标题移除（与背景 Logo 字标重复打架）回调轻量版 -->
        <Border Height="140" VerticalAlignment="Top" IsHitTestVisible="False"
                Background="{DynamicResource AppOnArtworkScrimBrush}"/>

        <Grid RowDefinitions="*,Auto" Margin="16,36,16,16">

            <!-- 顶部信息簇（方案 A，左对齐）：chips 行 → 确认条 → 空态卡。
                 左缩进 12 = 距内容卡左缘 28px。自绘游戏名标题已移除
                 （2026-09-25 用户决定：官方背景左上角自带烧录 Logo 字标，
                 自绘标题与之重复打架且无法稳定避让；识别职责由窗口
                 标题"游戏名 · 应用名"与侧栏选中项承担） -->
            <StackPanel Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Left"
                        Margin="12,12,0,0" Spacing="16">
                <!-- 校验修复确认条（包式渠道无逐文件清单：修复=整包重下覆盖安装，需确认）；
                     无 BoxShadow：真机 HDR 路径会把模糊阴影呈成硬边矩形板（同 toast-card） -->
                <Border HorizontalAlignment="Left"
                        Padding="16,12" CornerRadius="12"
                        Background="{DynamicResource AppOnArtworkCard}"
                        BorderBrush="{DynamicResource AppOnArtworkCardBorder}"
                        BorderThickness="1"
                        IsVisible="{Binding ShowRepairConfirm}">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBlock Text="{Binding RepairConfirmText}" MaxWidth="430"
                                   TextWrapping="Wrap" FontSize="13"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppOnArtworkBrush}"/>
                        <Button Classes="btn-sm pressable danger-onart"
                                Content="{Binding Loc[verify_confirm_yes]}"
                                Command="{Binding ConfirmRepairCommand}"
                                VerticalAlignment="Center"/>
                        <Button Classes="btn-sm pressable glass-onart"
                                Content="{Binding Loc[verify_confirm_no]}"
                                Command="{Binding CancelRepairCommand}"
                                VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <!-- chips 行：状态 + 已暂存徽章 + 版本迁移（金色数字段）。
                     WrapPanel 限宽 640：长状态文案挤不下时后续 chip 换行而非裁剪/
                     溢出内容卡（水平 StackPanel 只会原样溢出，窄窗口下被裁）；
                     StatusText 另有 MaxWidth=430 换行，双保险 -->
                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8"
                           MaxWidth="640">
                    <Border Classes="onart-chip" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Classes="dot" Width="11" Height="11" VerticalAlignment="Center"
                                     Classes.installed="{Binding CanLaunch}"
                                     Classes.has-update="{Binding HasUpdate}"
                                     Classes.predownload="{Binding ShowPredownloadCue}"/>
                            <TextBlock Text="{Binding StatusText}" FontSize="14" FontWeight="SemiBold"
                                       MaxWidth="430" TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource AppOnArtworkBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Padding="12,4" CornerRadius="14" VerticalAlignment="Center"
                            Background="{DynamicResource AppPredownloadBadge}"
                            IsVisible="{Binding HasStagedPredownload}">
                        <TextBlock Text="{Binding Loc[game_stagedBadge]}" FontSize="12"
                                   Foreground="{DynamicResource AppPredownloadBadgeText}"/>
                    </Border>
                    <!-- 版本 chip：前导 + 金色号码（+ 迁移中段 + 金色目标号码），独立胶囊 -->
                    <Border Padding="12,4" CornerRadius="14" VerticalAlignment="Center"
                            Background="{DynamicResource AppVersionChipBackground}">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding VersionChipLead}" FontSize="13"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource AppVersionChipText}"/>
                            <TextBlock Text="{Binding VersionChipNumber}" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource AppVersionChipAccent}"/>
                            <TextBlock Text="{Binding VersionChipMid}" FontSize="13"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding VersionChipMid, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                       Foreground="{DynamicResource AppVersionChipText}"/>
                            <TextBlock Text="{Binding VersionChipTarget}" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       IsVisible="{Binding VersionChipTarget, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                       Foreground="{DynamicResource AppVersionChipAccent}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- 未安装空态引导卡（评审 P1-2：空态要设计、禁用钮说明原因）：
                     用现有数据（渠道/最新版本/服务器/安装目录）组装，
                     与确认条同款玻璃卡；已安装即隐藏 -->
                <Border x:Name="EmptyStateCard"
                        HorizontalAlignment="Left" MaxWidth="480"
                        Padding="16,12" CornerRadius="12"
                        Background="{DynamicResource AppOnArtworkCard}"
                        BorderBrush="{DynamicResource AppOnArtworkCardBorder}"
                        BorderThickness="1"
                        IsVisible="{Binding ShowEmptyState}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{Binding Loc[detail_emptyTitle]}"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppOnArtworkBrush}"/>
                        <TextBlock Text="{Binding Loc[detail_emptyHint]}"
                                   FontSize="13" TextWrapping="Wrap"
                                   Foreground="{DynamicResource AppOnArtworkSecondary}"/>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Loc[game_info_channel]}"
                                       Classes="dock-caption" LineHeight="22" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding ChannelDisplayName}"
                                       FontSize="13" LineHeight="22" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AppOnArtworkBrush}"/>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                            <TextBlock Text="{Binding Loc[version_label_latest]}"
                                       Classes="dock-caption" LineHeight="22" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding VersionChipNumber}"
                                       FontSize="13" LineHeight="22" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AppOnArtworkBrush}"/>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                            <TextBlock Text="{Binding Loc[game_server]}"
                                       Classes="dock-caption" LineHeight="22" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding ServerCountText}"
                                       FontSize="13" LineHeight="22" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AppOnArtworkBrush}"/>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                            <TextBlock Text="{Binding Loc[game_info_installDir]}"
                                       Classes="dock-caption" LineHeight="22" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding InstallDirPath}"
                                       FontSize="13" LineHeight="22"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding InstallDirPath}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource AppOnArtworkBrush}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 底部操作坞（通栏玻璃条）：左列渠道/目录信息（busy 时变进度条），
                 右列按钮按"图标 → 次级 → 主 CTA 最右"排布——原按钮行/进度卡/页脚三行合并于此 -->
            <controls:DetailActionDock Grid.Row="1"/>

        </Grid>

        <!-- 启动失败覆盖层：类目化原因 + 技术详情 + 日志入口 + umu 引导安装 -->
        <controls:LaunchErrorOverlay/>
    </Panel>
</UserControl>
